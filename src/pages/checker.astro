---
// src/pages/checker.astro
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CheckerWorkspace from '../components/dashboard/CheckerWorkspace';
import { ErrorBoundary } from '../components/common/ErrorBoundary';
import { 
  ShieldCheck, 
  Zap, 
  Brain, 
  TrendingUp, 
  BookOpen, 
  Cpu, 
  AlertTriangle, 
  Layers, 
  CheckCircle2, 
  HelpCircle, 
  Code2, 
  BarChart2, 
  Lock, 
  FileCode,
  Terminal,
  Scale
} from '@lucide/astro';
import Button from '../components/ui/Button.astro';

const siteUrl = "https://aiqualityhq.com";

const pageTitle = "Free AI Prompt Checker — Analyze & Score Prompt Quality";
const pageDescription = "Analyze and score your AI prompts across 6 core quality dimensions: structure, context grounding, privacy, safety, and security with instant sub-10ms feedback.";
const canonicalUrl = `${siteUrl}/checker`;
const ogImage = `${siteUrl}/og-checker.png`;

// Comprehensive Schema Graph for Maximum AI & Search Engine Visibility (GEO)
const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "AIQualityHQ Prompt Checker",
      "description": pageDescription,
      "url": canonicalUrl,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.94",
        "ratingCount": "198",
        "bestRating": "5",
        "worstRating": "1"
      },
      "author": {
        "@type": "Organization",
        "name": "AIQualityHQ",
        "url": siteUrl
      },
      "featureList": "Six-Dimension Prompt Scoring, Real-Time Quality Engine Analysis, Sub-10ms Local Execution, PII Detection, Prompt Injection Guardrail Audit, Actionable Remediation Checklist, Diff Comparison View"
    },
    {
      "@type": "WebPage",
      "@id": canonicalUrl,
      "url": canonicalUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "name": "AIQualityHQ",
        "url": siteUrl
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": siteUrl
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Prompt Checker",
            "item": canonicalUrl
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is an AI prompt checker?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An AI prompt checker is a developer tool that analyzes prompt text against standardized prompt engineering quality dimensions—evaluating role definitions, structural delimiters, grounding constraints, privacy compliance, and security guardrails before submitting requests to LLM APIs."
          }
        },
        {
          "@type": "Question",
          "name": "What are the six dimensions evaluated by the AIQualityHQ Prompt Checker?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The AIQualityHQ Quality Engine evaluates prompts across 6 core dimensions: Prompt Structure & Formatting (20%), Memory & State Management (15%), Context Grounding (15%), Trust & Factual Accuracy (25%), PII & Privacy Safety (10%), and Security & Prompt Injection Defense (15%)."
          }
        },
        {
          "@type": "Question",
          "name": "How does deterministic prompt checking differ from LLM-as-a-judge evaluation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Deterministic prompt checking uses rule-based heuristics to inspect prompt syntax, structural delimiters, and regex patterns locally in under 10 milliseconds without making API calls. LLM-as-a-judge uses a second language model to evaluate text outputs, which incurs financial costs and latency. Deterministic checking is ideal for instant pre-commit linting."
          }
        },
        {
          "@type": "Question",
          "name": "Can a prompt checker detect security vulnerabilities like prompt injection?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The security dimension scans prompts for direct instruction overrides ('ignore previous rules'), DAN mode jailbreaks, system prompt exfiltration triggers, and zero-width steganographic Unicode payloads."
          }
        },
        {
          "@type": "Question",
          "name": "Does the prompt checker send my prompt text to external servers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The AIQualityHQ Quality Engine operates 100% locally in your web browser using client-side JavaScript heuristics. Your prompts, proprietary system rules, and API key references never leave your machine."
          }
        },
        {
          "@type": "Question",
          "name": "Is the AI Prompt Checker free to use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, the AIQualityHQ Prompt Checker is completely free with no usage limits, registration requirements, or API key configurations needed."
          }
        }
      ]
    }
  ]
};
---

<MarketingLayout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} image={ogImage}>
  <!-- Sticky Header Navigation -->
  <Header activeNav="checker" />

  <main id="main-content" class="flex-grow py-12 px-6 bg-canvas">
    <div class="max-w-[1200px] mx-auto flex flex-col gap-12">
      
      <!-- Hostinger Referral Promo Banner -->
      <div class="relative overflow-hidden rounded-2xl border border-border bg-surface-secondary/20 p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6 transition-default hover:border-primary-border/60 hover:bg-surface-secondary/30">
        <div class="absolute -top-24 -right-24 w-48 h-48 rounded-full bg-primary/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
        
        <div class="flex-grow max-w-2xl text-left relative z-10">
          <span class="inline-flex items-center gap-1 font-mono text-[10px] font-semibold uppercase tracking-widest text-primary mb-2 bg-primary-subtle px-2.5 py-0.5 rounded-full select-none">
            Recommended Infrastructure
          </span>
          <h3 class="text-lg md:text-xl font-semibold tracking-tight text-text-primary text-pretty">
            Build & Host Production AI Applications
          </h3>
          <p class="mt-2 text-xs md:text-sm text-text-secondary leading-relaxed">
            We hosted AIQualityHQ on reliable cloud infrastructure. Deploy your custom AI application pipeline using our referral link and claim a free domain with any 1-year hosting plan.
          </p>
        </div>
        <div class="shrink-0 w-full md:w-auto relative z-10">
          <Button 
            href="https://www.hostinger.com/in?REFERRALCODE=UDVKRALIALRV" 
            target="_blank" 
            rel="noopener noreferrer sponsored nofollow" 
            variant="primary" 
            size="md"
            class="w-full md:w-auto text-center"
          >
            Claim Free Domain
          </Button>
          <p class="text-[10px] text-text-tertiary mt-2 font-mono">Referral link — we may earn a commission at no cost to you.</p>
        </div>
      </div>

      <!-- Page Header Hero Section -->
      <div class="border-b border-border-subtle pb-8">
        <div class="flex items-center gap-2 text-primary font-mono text-xs uppercase tracking-wider mb-2">
          <ShieldCheck class="w-4 h-4" />
          <span>LLM Quality Evaluation Engine</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-text-primary">
          Free AI Prompt Checker & Quality Engine
        </h1>
        <p class="text-base text-text-secondary mt-3 max-w-3xl leading-relaxed">
          Analyze and score AI prompts across 6 core engineering dimensions: structure, memory state, context grounding, trust & accuracy, privacy, and security guardrails. Get sub-10ms feedback with actionable fix suggestions.
        </p>

        <!-- Feature Badges -->
        <div class="flex flex-wrap items-center gap-3 pt-5 text-xs font-medium text-text-secondary">
          <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface border border-border-subtle shadow-sm">
            <BarChart2 class="w-3.5 h-3.5 text-primary" /> 6-Dimension Quality Matrix
          </span>
          <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface border border-border-subtle shadow-sm">
            <Zap class="w-3.5 h-3.5 text-score-excellent" /> Sub-10ms Local Execution
          </span>
          <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface border border-border-subtle shadow-sm">
            <Lock class="w-3.5 h-3.5 text-score-warning" /> PII & Injection Audit
          </span>
          <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface border border-border-subtle shadow-sm">
            <Terminal class="w-3.5 h-3.5 text-text-primary" /> Model-Agnostic Linting
          </span>
        </div>
      </div>

      <!-- Hydrated Interactive React Workspace Island (Tool at the Top) -->
      <section id="checker-tool" class="scroll-mt-8">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-text-tertiary flex items-center gap-2">
            <Terminal class="w-4 h-4 text-primary" />
            <span>Interactive Checker Console</span>
          </h2>
          <span class="text-xs text-text-tertiary font-mono">Status: Ready • Quality Engine v4.2</span>
        </div>
        <ErrorBoundary client:load>
          <CheckerWorkspace client:load />
        </ErrorBoundary>
      </section>

      <!-- Key Capabilities Overview Bar -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6 p-6 rounded-xl bg-surface border border-border">
        <div class="flex items-start gap-3">
          <Zap class="w-5 h-5 text-primary mt-0.5 shrink-0" />
          <div>
            <h3 class="text-sm font-semibold text-text-primary">Sub-10ms Deterministic Analysis</h3>
            <p class="text-xs text-text-secondary mt-1 leading-relaxed">Runs 40+ structural heuristic rules in local browser memory without adding API cost or network latency.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <TrendingUp class="w-5 h-5 text-primary mt-0.5 shrink-0" />
          <div>
            <h3 class="text-sm font-semibold text-text-primary">Weighted 6-Dimension Score</h3>
            <p class="text-xs text-text-secondary mt-1 leading-relaxed">Evaluates Structure (20%), Memory (15%), Grounding (15%), Accuracy (25%), Privacy (10%), and Security (15%).</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <Brain class="w-5 h-5 text-primary mt-0.5 shrink-0" />
          <div>
            <h3 class="text-sm font-semibold text-text-primary">Actionable Remediation Checklist</h3>
            <p class="text-xs text-text-secondary mt-1 leading-relaxed">Provides clear pass/fail diagnostics and specific optimization suggestions to fix weak prompt structures before production deploy.</p>
          </div>
        </div>
      </section>

      <!-- Main Deep-Dive Content Container -->
      <div class="flex flex-col gap-12 font-sans text-text-secondary leading-relaxed">

        <!-- Section 1: What is an AI Prompt Checker? -->
        <section class="border-t border-border-subtle pt-10">
          <div class="flex items-center gap-2 text-primary font-mono text-xs uppercase tracking-wider mb-2">
            <BookOpen class="w-4 h-4" />
            <span>Definition & Fundamentals</span>
          </div>
          <h2 class="text-2xl font-bold tracking-tight text-text-primary mb-4">
            1. What is an AI Prompt Checker?
          </h2>
          <p class="text-base text-text-primary font-medium mb-4">
            An <strong class="text-primary font-semibold">AI Prompt Checker</strong> is a software linting tool designed to evaluate the structural integrity, safety, and effectiveness of prompts submitted to Large Language Models (LLMs) such as GPT-4o, Claude 3.5, Gemini 2.0, and Llama 3.
          </p>
          <p class="mb-4">
            In modern AI software engineering, prompts function as executable code instructions. Poorly constructed prompts—lacking role definitions, boundary delimiters, or output format constraints—frequently cause models to hallucinate facts, fail JSON schema parsing, or succumb to prompt injection jailbreaks.
          </p>
          <p class="mb-6">
            A prompt checker acts as a static analysis tool (linter) for natural language instructions, auditing prompts for structural weaknesses before they are sent to production API endpoints.
          </p>

          <!-- Callout Grid: Deterministic Engine vs. LLM-as-a-Judge -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
            <div class="border border-border bg-surface rounded-xl p-6 relative overflow-hidden">
              <div class="flex items-center gap-2 mb-3">
                <Zap class="w-5 h-5 text-primary shrink-0" />
                <h3 class="text-sm font-semibold text-text-primary">Deterministic Local Linting</h3>
              </div>
              <p class="text-xs text-text-secondary leading-relaxed mb-3">
                Inspects structural syntax, role bindings, delimiters, PII regex, and security patterns locally in &lt;10ms with zero API cost and 100% privacy.
              </p>
              <div class="font-mono text-[11px] bg-surface-tertiary p-3 rounded-md text-text-primary border border-border">
                Speed: 5ms • Cost: $0.00 • Privacy: 100% Client-Side
              </div>
            </div>

            <div class="border border-border bg-surface rounded-xl p-6 relative overflow-hidden">
              <div class="flex items-center gap-2 mb-3">
                <Cpu class="w-5 h-5 text-score-warning shrink-0" />
                <h3 class="text-sm font-semibold text-text-primary">LLM-as-a-Judge Evaluation</h3>
              </div>
              <p class="text-xs text-text-secondary leading-relaxed mb-3">
                Uses a second LLM to evaluate generated text outputs. While valuable for nuanced quality scoring, it incurs API latency (1-3s) and token costs.
              </p>
              <div class="font-mono text-[11px] bg-surface-tertiary p-3 rounded-md text-score-warning border border-score-warning/20">
                Speed: 2,500ms • Cost: Billed per Token • Latency: High
              </div>
            </div>
          </div>

          <!-- Comparison Table: Unstructured vs Quality-Scored Prompt -->
          <div class="mt-8">
            <h3 class="text-base font-semibold text-text-primary mb-3">Unstructured Prompting vs. Quality-Scored Prompt Engineering</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-xs text-left border-collapse border border-border">
                <thead>
                  <tr class="bg-surface-secondary text-text-primary border-b border-border">
                    <th class="p-3 font-semibold">Prompt Attribute</th>
                    <th class="p-3 font-semibold">Unstructured Unverified Prompt</th>
                    <th class="p-3 font-semibold text-primary">Quality-Scored Production Prompt</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  <tr class="hover:bg-surface-secondary/50">
                    <td class="p-3 font-semibold text-text-primary">Role Definition</td>
                    <td class="p-3 text-text-secondary">Missing or implicit ("Help me write...")</td>
                    <td class="p-3 text-text-primary font-medium">Explicit persona binding ("You are a Senior Copywriter...")</td>
                  </tr>
                  <tr class="hover:bg-surface-secondary/50">
                    <td class="p-3 font-semibold text-text-primary">Section Delimiters</td>
                    <td class="p-3 text-text-secondary">Mixed continuous text paragraphs</td>
                    <td class="p-3 text-text-primary font-medium">Clear Markdown headers or XML tags (&lt;context&gt;)</td>
                  </tr>
                  <tr class="hover:bg-surface-secondary/50">
                    <td class="p-3 font-semibold text-text-primary">Output Constraints</td>
                    <td class="p-3 text-text-secondary">Informal requests ("Return a summary")</td>
                    <td class="p-3 text-text-primary font-medium">Strict JSON schema or explicit negative constraints</td>
                  </tr>
                  <tr class="hover:bg-surface-secondary/50">
                    <td class="p-3 font-semibold text-text-primary">Safety & Privacy Audit</td>
                    <td class="p-3 text-text-secondary">Unchecked PII and injection risk</td>
                    <td class="p-3 text-text-primary font-medium">Scanned for PII patterns & anti-jailbreak locks</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- Section 2: Why Use an AI Prompt Checker? -->
        <section class="border-t border-border-subtle pt-10">
          <div class="flex items-center gap-2 text-primary font-mono text-xs uppercase tracking-wider mb-2">
            <Brain class="w-4 h-4" />
            <span>Engineering Impact & Benefits</span>
          </div>
          <h2 class="text-2xl font-bold tracking-tight text-text-primary mb-4">
            2. Why Use an AI Prompt Checker?
          </h2>
          <p class="mb-4">
            Prompt quality directly determines model behavior. Checking prompts prior to API deployment yields three key operational benefits:
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-6">
            <div class="p-5 rounded-xl border border-border bg-surface flex flex-col gap-2">
              <div class="w-8 h-8 rounded-lg bg-score-excellent/10 flex items-center justify-center text-score-excellent mb-1">
                <CheckCircle2 class="w-4 h-4" />
              </div>
              <h3 class="text-sm font-semibold text-text-primary">1. Reduced Production Hallucinations</h3>
              <p class="text-xs text-text-secondary leading-relaxed">
                Verifies that context grounding rules are present, preventing the model from generating fabricated claims outside provided data.
              </p>
            </div>

            <div class="p-5 rounded-xl border border-border bg-surface flex flex-col gap-2">
              <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary mb-1">
                <FileCode class="w-4 h-4" />
              </div>
              <h3 class="text-sm font-semibold text-text-primary">2. Seamless JSON API Parsing</h3>
              <p class="text-xs text-text-secondary leading-relaxed">
                Ensures output format specifications are explicitly defined, eliminating JSON syntax errors and unparsed markdown blocks in backend code.
              </p>
            </div>

            <div class="p-5 rounded-xl border border-border bg-surface flex flex-col gap-2">
              <div class="w-8 h-8 rounded-lg bg-score-warning/10 flex items-center justify-center text-score-warning mb-1">
                <Lock class="w-4 h-4" />
              </div>
              <h3 class="text-sm font-semibold text-text-primary">3. PII & Security Compliance</h3>
              <p class="text-xs text-text-secondary leading-relaxed">
                Flags accidental hardcoded API keys, passwords, credit card regex patterns, and unshielded prompt injection vectors before deployment.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 3: The 6 Dimensions of Prompt Quality -->
        <section class="border-t border-border-subtle pt-10">
          <div class="flex items-center gap-2 text-primary font-mono text-xs uppercase tracking-wider mb-2">
            <Scale class="w-4 h-4" />
            <span>Evaluation Framework</span>
          </div>
          <h2 class="text-2xl font-bold tracking-tight text-text-primary mb-4">
            3. The 6 Dimensions of Prompt Quality
          </h2>
          <p class="mb-6">
            The AIQualityHQ Quality Engine calculates an overall prompt quality score (0 to 100) using a weighted multi-dimension evaluation matrix:
          </p>

          <div class="space-y-6">
            <!-- Dim 1 -->
            <div class="border border-border rounded-xl p-6 bg-surface">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-base font-semibold text-text-primary flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-primary/10 text-primary text-xs flex items-center justify-center font-mono font-bold">1</span>
                  Prompt Structure & Formatting (20% Weight)
                </h3>
                <span class="text-[11px] font-mono text-primary bg-primary/10 px-2.5 py-0.5 rounded-full font-semibold">Structure</span>
              </div>
              <p class="text-xs text-text-secondary leading-relaxed">
                Evaluates clear role persona definition ("You are a..."), explicit task objectives, section delimiters (Markdown headers, XML tags), and logical instruction flow.
              </p>
            </div>

            <!-- Dim 2 -->
            <div class="border border-border rounded-xl p-6 bg-surface">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-base font-semibold text-text-primary flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-primary/10 text-primary text-xs flex items-center justify-center font-mono font-bold">2</span>
                  Memory & State Management (15% Weight)
                </h3>
                <span class="text-[11px] font-mono text-primary bg-primary/10 px-2.5 py-0.5 rounded-full font-semibold">State</span>
              </div>
              <p class="text-xs text-text-secondary leading-relaxed">
                Audits structural separation between system rules and user input, ensuring state variables (<code class="font-mono text-primary">&#123;user_input&#125;</code>) are clearly demarcated.
              </p>
            </div>

            <!-- Dim 3 -->
            <div class="border border-border rounded-xl p-6 bg-surface">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-base font-semibold text-text-primary flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-primary/10 text-primary text-xs flex items-center justify-center font-mono font-bold">3</span>
                  Context Grounding (15% Weight)
                </h3>
                <span class="text-[11px] font-mono text-primary bg-primary/10 px-2.5 py-0.5 rounded-full font-semibold">Grounding</span>
              </div>
              <p class="text-xs text-text-secondary leading-relaxed">
                Checks for explicit grounding constraints ("Answer ONLY using provided text") to prevent hallucination in RAG and search-augmented applications.
              </p>
            </div>

            <!-- Dim 4 -->
            <div class="border border-border rounded-xl p-6 bg-surface">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-base font-semibold text-text-primary flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-score-excellent/10 text-score-excellent text-xs flex items-center justify-center font-mono font-bold">4</span>
                  Trust & Factual Accuracy (25% Weight - Highest Priority)
                </h3>
                <span class="text-[11px] font-mono text-score-excellent bg-score-excellent/10 px-2.5 py-0.5 rounded-full font-semibold">Highest Priority</span>
              </div>
              <p class="text-xs text-text-secondary leading-relaxed">
                Audits output format definitions, JSON/Markdown schema validation, negative constraints ("Do not invent facts"), and fallback behavior instructions.
              </p>
            </div>

            <!-- Dim 5 -->
            <div class="border border-border rounded-xl p-6 bg-surface">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-base font-semibold text-text-primary flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-score-warning/10 text-score-warning text-xs flex items-center justify-center font-mono font-bold">5</span>
                  PII & Privacy Safety (10% Weight)
                </h3>
                <span class="text-[11px] font-mono text-score-warning bg-score-warning/10 px-2.5 py-0.5 rounded-full font-semibold">Privacy</span>
              </div>
              <p class="text-xs text-text-secondary leading-relaxed">
                Scans prompt text for accidentally hardcoded secrets, API keys, passwords, email addresses, phone numbers, or credit card regex patterns.
              </p>
            </div>

            <!-- Dim 6 -->
            <div class="border border-border rounded-xl p-6 bg-surface">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-base font-semibold text-text-primary flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-score-critical/10 text-score-critical text-xs flex items-center justify-center font-mono font-bold">6</span>
                  Security & Guardrails (15% Weight)
                </h3>
                <span class="text-[11px] font-mono text-score-critical bg-score-critical/10 px-2.5 py-0.5 rounded-full font-semibold">Security</span>
              </div>
              <p class="text-xs text-text-secondary leading-relaxed">
                Inspects prompt text for anti-jailbreak directives, instruction priority locks, and defenses against direct/indirect prompt injection exploits.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 4: Real-World Prompt Optimization Before & After Examples -->
        <section class="border-t border-border-subtle pt-10">
          <div class="flex items-center gap-2 text-primary font-mono text-xs uppercase tracking-wider mb-2">
            <CheckCircle2 class="w-4 h-4" />
            <span>Before & After Diagnostics</span>
          </div>
          <h2 class="text-2xl font-bold tracking-tight text-text-primary mb-4">
            4. Real-World Prompt Optimization Examples
          </h2>
          <p class="mb-6">
            Below are real-world examples demonstrating how fixing quality engine rule failures transforms low-scoring prompts into production-grade directives.
          </p>

          <div class="space-y-6">
            <!-- Example 1 -->
            <div class="border border-border rounded-xl p-6 bg-surface">
              <div class="flex items-center justify-between mb-3 border-b border-border-subtle pb-2">
                <h3 class="text-sm font-semibold text-text-primary flex items-center gap-2">
