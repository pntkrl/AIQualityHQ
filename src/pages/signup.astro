---
// src/pages/signup.astro
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';
import SocialLogin from '../components/auth/SocialLogin';
import { ShieldAlert, CheckCircle2, Key, Mail } from '@lucide/astro';
import { OAUTH_CONFIG } from '../lib/social-auth';

const siteUrl = "https://aiqualityhq.com";
const pageTitle = "Sign Up — AIQualityHQ";
const pageDescription = "Create your AIQualityHQ account to unlock prompt target compilers, jailbreak scanners, and developer quality engines.";
---

<MarketingLayout title={pageTitle} description={pageDescription} canonicalUrl={`${siteUrl}/signup`} noindex={true}>
  <Header />
  <main id="main-content" class="flex-grow flex flex-col items-center justify-center bg-canvas px-6 py-12 md:py-20">
    <div class="w-full max-w-[420px] flex flex-col gap-6">

      <!-- Signup Card -->
      <Card class="p-6 md:p-8 flex flex-col gap-5">
        <div class="text-center">
          <h1 id="card-title" class="text-base font-semibold text-text-primary">Create your account</h1>
          <p id="card-desc" class="text-xs text-text-secondary mt-1">Unlock developer prompt tools & target compilers</p>
        </div>

        <!-- Error Banner -->
        <div id="error-banner" class="hidden border border-error-subtle bg-error-subtle text-error p-3 rounded-lg flex items-start gap-2 text-xs font-sans">
          <ShieldAlert class="w-4 h-4 shrink-0 mt-0.5" />
          <span id="error-message">Account registration failed.</span>
        </div>

        <!-- Success Banner -->
        <div id="success-banner" class="hidden border border-score-excellent-border bg-score-excellent-subtle text-score-excellent p-3 rounded-lg flex items-start gap-2 text-xs font-sans">
          <CheckCircle2 class="w-4 h-4 shrink-0 mt-0.5" />
          <span id="success-message">Verification code sent!</span>
        </div>

        <!-- STEP 1: Registration Form -->
        <form id="signup-form" class="flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="signup-name" class="text-[10px] font-mono font-semibold uppercase tracking-wider text-text-secondary">Name</label>
            <Input type="text" id="signup-name" name="name" placeholder="John Doe" required />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="signup-email" class="text-[10px] font-mono font-semibold uppercase tracking-wider text-text-secondary">Email Address</label>
            <Input type="email" id="signup-email" name="email" placeholder="name@company.com" required />
            <span class="text-[10px] text-text-tertiary">Work or personal email (disposable emails prohibited).</span>
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="signup-password" class="text-[10px] font-mono font-semibold uppercase tracking-wider text-text-secondary">Password</label>
            <Input type="password" id="signup-password" name="password" placeholder="••••••••" required />
          </div>
          
          <!-- Consent box -->
          <div class="flex items-start gap-2.5 mt-1 select-none">
            <input type="checkbox" id="signup-agree" required class="mt-0.5 rounded border-border text-primary focus:ring-primary w-4 h-4 cursor-pointer" />
            <label for="signup-agree" class="text-[11px] text-text-secondary leading-relaxed font-sans cursor-pointer">
              I agree to the <a href="/terms" target="_blank" class="text-primary hover:text-primary-hover underline font-medium">Terms</a> and <a href="/privacy" target="_blank" class="text-primary hover:text-primary-hover underline font-medium">Privacy Policy</a>.
            </label>
          </div>

          <Button type="submit" variant="primary" class="w-full mt-2 h-10 select-none">
            Create Account & Send Code
          </Button>
        </form>

        <!-- STEP 2: 6-Digit OTP Verification Form (Hidden by default) -->
        <form id="otp-form" class="hidden flex-col gap-4 animate-fadeIn">
          <div class="p-3 rounded-lg bg-surface-secondary border border-border-subtle text-xs text-text-secondary flex items-center gap-2">
            <Mail class="w-4 h-4 text-primary shrink-0" />
            <span>Code sent to <strong id="verify-target-email" class="text-text-primary">user@example.com</strong></span>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="otp-code" class="text-[10px] font-mono font-semibold uppercase tracking-wider text-primary">
              Enter 6-Digit Verification Code
            </label>
            <Input
              type="text"
              id="otp-code"
              name="otp_code"
              placeholder="123456"
              maxlength="6"
              required
              class="font-mono text-center text-lg tracking-[8px] font-bold uppercase"
            />
          </div>

          <Button type="submit" variant="primary" class="w-full h-10 select-none">
            Verify Email & Log In
          </Button>

          <button type="button" id="btn-back-signup" class="text-xs text-text-tertiary hover:text-text-primary transition-fast text-center underline cursor-pointer mt-1">
            Back to Registration
          </button>
        </form>

        <div id="social-login-wrapper">
          <SocialLogin googleClientId={OAUTH_CONFIG.googleClientId} client:load />
        </div>

        <div class="text-center pt-3 border-t border-border-subtle mt-1">
          <p class="text-xs text-text-secondary font-sans">
            Already have an account? 
            <a href="/login" class="text-primary hover:text-primary-hover font-semibold underline underline-offset-2 transition-fast ml-1">
              Log in
            </a>
          </p>
        </div>
      </Card>

    </div>
  </main>
  <Footer />
</MarketingLayout>

<script>
  const apiBase = window.location.origin + '/api';

  const signupForm = document.getElementById('signup-form') as HTMLFormElement | null;
  const otpForm = document.getElementById('otp-form') as HTMLFormElement | null;
  const errorBanner = document.getElementById('error-banner');
  const errorMessage = document.getElementById('error-message');
  const successBanner = document.getElementById('success-banner');
  const successMessage = document.getElementById('success-message');
  const cardTitle = document.getElementById('card-title');
  const cardDesc = document.getElementById('card-desc');
  const verifyTargetEmail = document.getElementById('verify-target-email');
  const btnBackSignup = document.getElementById('btn-back-signup');
  const socialLoginWrapper = document.getElementById('social-login-wrapper');

  let activeEmail = '';

  const DISPOSABLE_DOMAINS_CLIENT = new Set([
    'tempmail.com', 'temp-mail.org', 'mailinator.com', '10minutemail.com',
    'guerrillamail.com', 'yopmail.com', 'trashmail.com', 'dispostable.com',
    'getnada.com', 'maildrop.cc', 'emailondeck.com', 'crazymailing.com'
  ]);

  if (btnBackSignup && signupForm && otpForm) {
    btnBackSignup.addEventListener('click', () => {
      otpForm.classList.add('hidden');
      signupForm.classList.remove('hidden');
      if (socialLoginWrapper) socialLoginWrapper.classList.remove('hidden');
      if (cardTitle) cardTitle.textContent = "Create your account";
      if (cardDesc) cardDesc.textContent = "Unlock developer prompt tools & target compilers";
    });
  }

  if (signupForm) {
    signupForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (errorBanner) errorBanner.classList.add('hidden');
      if (successBanner) successBanner.classList.add('hidden');

      const nameInput = document.getElementById('signup-name') as HTMLInputElement;
      const emailInput = document.getElementById('signup-email') as HTMLInputElement;
      const passwordInput = document.getElementById('signup-password') as HTMLInputElement;

      if (!nameInput || !emailInput || !passwordInput) return;

      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const password = passwordInput.value;

      // Client-side disposable domain check
      const domain = email.split('@').pop()?.toLowerCase() || '';
      if (DISPOSABLE_DOMAINS_CLIENT.has(domain)) {
        if (errorBanner && errorMessage) {
          errorMessage.textContent = "Disposable or temporary email addresses are prohibited. Please use a real work or personal email.";
          errorBanner.classList.remove('hidden');
        }
        return;
      }

      activeEmail = email;

      try {
        const res = await fetch(`${apiBase}/auth/signup`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password, name }),
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok && data.status === 'verification_required') {
          signupForm.classList.add('hidden');
          if (socialLoginWrapper) socialLoginWrapper.classList.add('hidden');
          if (otpForm) {
            otpForm.classList.remove('hidden');
            otpForm.classList.add('flex');
          }
          if (cardTitle) cardTitle.textContent = "Verify your email";
          if (cardDesc) cardDesc.textContent = "Enter the 6-digit code sent to your inbox";
          if (verifyTargetEmail) verifyTargetEmail.textContent = email;

          if (successBanner && successMessage) {
            successMessage.textContent = data.message || "A 6-digit code has been sent to your email.";
            successBanner.classList.remove('hidden');
          }
          return;
        }

        if (errorBanner && errorMessage) {
          errorMessage.textContent = data.error || 'Registration failed.';
          errorBanner.classList.remove('hidden');
        }
      } catch (err: any) {
        if (errorBanner && errorMessage) {
          errorMessage.textContent = 'Network error. Please try again.';
          errorBanner.classList.remove('hidden');
        }
      }
    });
  }

  // STEP 2: OTP Submit Handler
  if (otpForm) {
    otpForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (errorBanner) errorBanner.classList.add('hidden');
      if (successBanner) successBanner.classList.add('hidden');

      const otpInput = document.getElementById('otp-code') as HTMLInputElement;
      if (!otpInput) return;

      const code = otpInput.value.trim();

      try {
        const res = await fetch(`${apiBase}/auth/verify-email`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: activeEmail, code }),
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok) {
          localStorage.setItem('aiq_session_token', data.session.token);
          localStorage.setItem('user_session', JSON.stringify({
            email: data.user.email,
            name: data.user.name,
            id: data.user.id,
            timestamp: Date.now()
          }));

          if (successBanner && successMessage) {
            successMessage.textContent = "Email verified! Redirecting to dashboard...";
            successBanner.classList.remove('hidden');
          }

          setTimeout(() => {
            window.location.href = '/dashboard';
          }, 1000);
          return;
        }

        if (errorBanner && errorMessage) {
          errorMessage.textContent = data.error || 'Invalid verification code.';
          errorBanner.classList.remove('hidden');
        }
      } catch (err) {
        if (errorBanner && errorMessage) {
          errorMessage.textContent = 'Verification error. Please try again.';
          errorBanner.classList.remove('hidden');
        }
      }
    });
  }
</script>
