---
// src/pages/pricing.astro
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import { Check, Zap, ShieldCheck, Server, Clock, Lock } from '@lucide/astro';

const siteUrl = "https://aiqualityhq.com";
const pageTitle = "Pricing — Free Forever, Pro & Team Plans";
const pageDescription = "AIQualityHQ pricing. Free prompt quality tools forever, with Pro and Team API plans for high-volume deterministic checking, injection scanning, and jailbreak detection.";

const plans = [
  {
    name: "Free",
    monthlyPrice: "$0",
    yearlyPrice: "$0",
    tagline: "Everything in your browser, free forever.",
    cta: "Start Free",
    href: "/signup",
    highlight: false,
    features: [
      "All 7 interactive web tools",
      "6-dimension prompt quality scoring",
      "Prompt rewriter & system prompt generator",
      "Injection scanner & jailbreak detector",
      "Report export & prompt history",
      "60 API requests / hour",
      "100% client-side processing"
    ]
  },
  {
    name: "Pro",
    monthlyPrice: "$19",
    yearlyPrice: "$15",
    tagline: "For builders shipping AI features in production.",
    cta: "Sign Up & Upgrade",
    href: "/signup",
    highlight: true,
    features: [
      "Everything in Free",
      "10,000 API requests / hour",
      "REST API access & SDKs",
      "Full report history (unlimited)",
      "Advanced AI visibility scorecard",
      "Priority email support",
      "Early access to new tools"
    ]
  },
  {
    name: "Team",
    monthlyPrice: "$49",
    yearlyPrice: "$39",
    tagline: "For teams with high-volume automated pipelines.",
    cta: "Sign Up & Upgrade",
    href: "/signup",
    highlight: false,
    features: [
      "Everything in Pro",
      "50,000 API requests / hour",
      "Shared team workspaces",
      "SSO & role-based access",
      "Custom rate limits",
      "Dedicated support & onboarding"
    ]
  }
];
---

<MarketingLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${siteUrl}/pricing`}
  image={`${siteUrl}/og-checker.png`}
>
  <Header />

  <main id="main-content" class="flex-grow py-16 px-6">
    <div class="max-w-[1000px] mx-auto">

      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="font-mono text-xs font-semibold uppercase tracking-widest text-primary mb-3 block">
          Pricing
        </span>
        <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-text-primary">
          Free forever. Pay only when you need scale.
        </h1>
        <p class="mt-4 text-text-secondary leading-relaxed">
          Every interactive tool runs 100% in your browser at no cost. Upgrade only if you want to call the deterministic engine via API at scale.
        </p>
      </div>

      <!-- Pricing Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          plans.map((plan) => (
            <div
              class:list={[
                "relative flex flex-col rounded-2xl border p-6 bg-surface",
                plan.highlight
                  ? "border-primary shadow-floating md:-translate-y-2"
                  : "border-border"
              ]}
            >
              {plan.highlight && (
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 inline-flex items-center gap-1 rounded-full bg-primary text-on-primary px-3 py-1 text-[10px] font-mono font-semibold uppercase tracking-widest">
                  <Zap class="w-3 h-3" aria-hidden="true" />
                  Most Popular
                </span>
              )}
              <h2 class="text-sm font-semibold text-text-primary uppercase tracking-wider">{plan.name}</h2>
              <p class="mt-1 text-xs text-text-tertiary leading-relaxed min-h-[32px]">{plan.tagline}</p>

              <div class="mt-4 flex items-baseline gap-1">
                <span class="text-3xl font-bold font-mono text-text-primary">{plan.monthlyPrice}</span>
                <span class="text-xs text-text-tertiary">/ month</span>
              </div>
              <p class="text-[11px] text-text-tertiary mt-1">
                {plan.monthlyPrice === "$0" ? "No card required" : `$${plan.yearlyPrice} / month billed yearly`}
              </p>

              <ul class="mt-6 space-y-2.5 flex-1">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-sm text-text-secondary">
                    <Check class="w-4 h-4 text-primary shrink-0 mt-0.5" aria-hidden="true" />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>

              <Button href={plan.href} size="md" variant={plan.highlight ? "primary" : "secondary"} class="w-full mt-8">
                {plan.cta}
              </Button>
            </div>
          ))
        }
      </div>

      <!-- Why Pro is most popular -->
      <div class="mt-6 rounded-2xl border border-primary/25 bg-primary-subtle/20 p-6 flex flex-col sm:flex-row items-start gap-4">
        <div class="p-2 rounded bg-primary-subtle text-primary shrink-0">
          <Zap class="w-5 h-5" aria-hidden="true" />
        </div>
        <div class="flex-1">
          <h3 class="text-sm font-semibold text-text-primary">Why Pro is the most popular pick</h3>
          <p class="text-xs text-text-secondary mt-1 leading-relaxed">
            Not because of marketing — because it's the first tier that unlocks what most builders actually need from a grader API:
          </p>
          <ul class="mt-3 space-y-2">
            <li class="flex items-start gap-2 text-xs text-text-secondary">
              <Check class="w-4 h-4 text-primary shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="text-text-primary">REST API access.</strong> Every paid plan below Pro runs browser tools only; Pro is the entry tier for calling the engine in CI/CD, scripts, or backend pipelines.</span>
            </li>
            <li class="flex items-start gap-2 text-xs text-text-secondary">
              <Check class="w-4 h-4 text-primary shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="text-text-primary">10,000 requests/hour.</strong> About 160× the Free tier — enough for production workloads without the per-seat overhead of Team.</span>
            </li>
            <li class="flex items-start gap-2 text-xs text-text-secondary">
              <Check class="w-4 h-4 text-primary shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="text-text-primary">No seat pricing.</strong> A fixed monthly price whether you run 10 checks a day or 10,000 — predictable for individual builders and small teams.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- API credits note -->
      <div class="mt-10 rounded-2xl border border-border-subtle bg-surface-secondary/40 p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <Server class="w-6 h-6 text-primary shrink-0" aria-hidden="true" />
        <div class="flex-1">
          <h3 class="text-sm font-semibold text-text-primary">API credits explained</h3>
          <p class="text-xs text-text-secondary mt-1 leading-relaxed">
            API limits reset hourly and are shared across the checker, scanner, detector, and audit endpoints. Browser tools are unlimited — they never count against your API quota.
          </p>
        </div>
      </div>

      <!-- Comparison table -->
      <div class="mt-16">
        <h2 class="text-2xl font-semibold tracking-tight text-text-primary text-center mb-8">
          Compare plans
        </h2>
        <div class="overflow-x-auto rounded-2xl border border-border">
          <table class="w-full text-sm text-left border-collapse">
            <thead>
              <tr class="bg-surface-secondary text-text-primary border-b border-border">
                <th class="p-4 font-semibold">Feature</th>
                <th class="p-4 font-semibold text-center">Free</th>
                <th class="p-4 font-semibold text-center text-primary">Pro</th>
                <th class="p-4 font-semibold text-center">Team</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-subtle">
              <tr>
                <td class="p-4 text-text-secondary">Interactive browser tools</td>
                <td class="p-4 text-center"><Check class="w-4 h-4 text-success inline" aria-hidden="true" /></td>
                <td class="p-4 text-center"><Check class="w-4 h-4 text-success inline" aria-hidden="true" /></td>
                <td class="p-4 text-center"><Check class="w-4 h-4 text-success inline" aria-hidden="true" /></td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">REST API requests / hour</td>
                <td class="p-4 text-center font-mono">60</td>
                <td class="p-4 text-center font-mono text-primary font-semibold">10,000</td>
                <td class="p-4 text-center font-mono">50,000</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">Report history</td>
                <td class="p-4 text-center font-mono">Limited</td>
                <td class="p-4 text-center font-mono">Unlimited</td>
                <td class="p-4 text-center font-mono">Unlimited</td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">AI visibility scorecard</td>
                <td class="p-4 text-center"><Check class="w-4 h-4 text-success inline" aria-hidden="true" /></td>
                <td class="p-4 text-center"><Check class="w-4 h-4 text-success inline" aria-hidden="true" /></td>
                <td class="p-4 text-center"><Check class="w-4 h-4 text-success inline" aria-hidden="true" /></td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">Shared team workspaces</td>
                <td class="p-4 text-center text-text-tertiary">—</td>
                <td class="p-4 text-center text-text-tertiary">—</td>
                <td class="p-4 text-center"><Check class="w-4 h-4 text-success inline" aria-hidden="true" /></td>
              </tr>
              <tr>
                <td class="p-4 text-text-secondary">Support</td>
                <td class="p-4 text-center text-text-tertiary">Community</td>
                <td class="p-4 text-center text-text-tertiary">Priority email</td>
                <td class="p-4 text-center text-text-tertiary">Dedicated</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Trust + FAQ -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="rounded-2xl border border-border-subtle bg-surface p-6">
          <div class="flex items-center gap-2 mb-3">
            <Clock class="w-5 h-5 text-primary" aria-hidden="true" />
            <h3 class="text-sm font-semibold text-text-primary">Instant, no waiting</h3>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">
            Analysis runs in your browser in under 10ms. No processing queue, no API call, no cost — even on the Free plan.
          </p>
        </div>
        <div class="rounded-2xl border border-border-subtle bg-surface p-6">
          <div class="flex items-center gap-2 mb-3">
            <Lock class="w-5 h-5 text-primary" aria-hidden="true" />
            <h3 class="text-sm font-semibold text-text-primary">Your prompts stay private</h3>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">
            Interactive tools never upload your prompt text. Deterministic scoring runs entirely client-side — nothing leaves your machine.
          </p>
        </div>
      </div>

      <div class="mt-12 rounded-2xl border border-border-subtle bg-surface p-8 text-center">
        <div class="flex items-center justify-center gap-2 mb-3">
          <ShieldCheck class="w-5 h-5 text-primary" aria-hidden="true" />
          <h3 class="text-base font-semibold text-text-primary">Need a custom plan or volume pricing?</h3>
        </div>
        <p class="text-sm text-text-secondary max-w-lg mx-auto leading-relaxed mb-5">
          We help teams running thousands of checks per hour get predictable pricing and custom rate limits.
        </p>
        <Button href="/contact" size="md" variant="secondary">Contact Sales</Button>
      </div>

    </div>
  </main>

  <Footer />
</MarketingLayout>
