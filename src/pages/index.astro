---
// src/pages/index.astro
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import HomeDemo from '../components/home/HomeDemo';
import {
  MessageSquare, Brain, Layers, Shield, Lock, ShieldCheck,
  ArrowRight, Zap, Search, Scissors, ShieldAlert, Sparkles,
  FileText, ChevronRight, CheckCircle2, Sliders, Cpu, Activity,
  Wand2, Eye, GitBranch, Code2, BarChart2
} from '@lucide/astro';

const siteUrl = "https://aiqualityhq.com";

const pageTitle = "AIQualityHQ — Free AI Prompt Quality Checker & LLM Tool Suite";
const pageDescription = "Free AI prompt quality checker & LLM tool suite. Evaluate, rewrite, optimize, scan injection threats, and audit prompt visibility with deterministic browser tools.";
const ogImage = `${siteUrl}/og-checker.png`;

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "AIQualityHQ Prompt Quality & AI Tool Suite",
      "description": pageDescription,
      "url": siteUrl,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": "Prompt Rewriting & Compilation, System Prompt Generation, Deterministic Prompt Quality Checking, Token & Cost Optimization, Prompt Injection Scanning, AI Jailbreak & Threat Detection, AI Visibility Scorecard & LLM Output Auditing"
    },
    {
      "@type": "ItemList",
      "name": "AIQualityHQ Free AI Tool Suite",
      "description": "Complete collection of browser-native prompt engineering and AI quality testing applications.",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "AI Prompt Rewriter & Compiler",
          "url": `${siteUrl}/prompt-rewriter`,
          "description": "Refactor, optimize, and target-compile raw prompts specifically for Claude 3.5, GPT-4o, and Gemini 2.0."
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "AI System Prompt Generator",
          "url": `${siteUrl}/ai-system-prompt-generator`,
          "description": "Synthesize production-grade LLM system instructions with role definitions, output schemas, and security locks."
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Prompt Quality Checker",
          "url": `${siteUrl}/checker`,
          "description": "6-dimension deterministic quality scoring engine evaluating structure, memory, context, accuracy, privacy, and security."
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Prompt Length & Token Optimizer",
          "url": `${siteUrl}/prompt-length-optimizer`,
          "description": "Heuristic token reduction, prompt trimming, filler elimination, and multi-provider LLM API cost estimation."
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "Prompt Injection Security Scanner",
          "url": `${siteUrl}/prompt-injection-scanner`,
          "description": "Red-team prompts against multi-vector injection attacks, DAN jailbreak patterns, and system instruction leakage."
        },
        {
          "@type": "ListItem",
          "position": 6,
          "name": "AI Jailbreak Detector & Threat Scanner",
          "url": `${siteUrl}/jailbreak-detector`,
          "description": "4-tier edge threat defense, direct/indirect prompt injection protection, multi-turn activation drift, and cryptographic attestation."
        },
        {
          "@type": "ListItem",
          "position": 7,
          "name": "AI Visibility Scorecard & LLM Auditor",
          "url": `${siteUrl}/ai-audit`,
          "description": "Domain AI visibility scorecard, llms.txt validator, frontier LLM grounding analysis, and response verification."
        },
        {
          "@type": "ListItem",
          "position": 8,
          "name": "AI Software Testing Suite & GEO Guides",
          "url": `${siteUrl}/artificial-intelligence-testing`,
          "description": "Comprehensive frameworks and deep technical guides for testing AI models, RAG pipelines, and Generative Engine Optimization."
        }
      ]
    },
    {
      "@type": "WebSite",
      "name": "AIQualityHQ",
      "url": siteUrl
    },
    {
      "@type": "Organization",
      "name": "AIQualityHQ",
      "url": siteUrl,
      "logo": `${siteUrl}/aiqualityhq-logo.png`,
      "description": "AI Quality HQ helps developers and AI engineers measure, improve, and trust every AI interaction with deterministic prompt tools."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What tools are included in the AIQualityHQ suite?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AIQualityHQ includes seven browser-native interactive applications: Prompt Rewriter & Compiler, AI System Prompt Generator, Prompt Quality Checker, Prompt Length & Token Optimizer, Prompt Injection Security Scanner, AI Jailbreak Detector, and AI Visibility Scorecard & Auditor, plus comprehensive AI software testing guides."
          }
        },
        {
          "@type": "Question",
          "name": "Is my prompt data private and secure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. All core AIQualityHQ tools execute 100% client-side inside your browser sandbox using local JavaScript. Proprietary prompt logic, system instructions, and code snippets are never transmitted to external servers."
          }
        },
        {
          "@type": "Question",
          "name": "How is AIQualityHQ different from asking an LLM to evaluate my prompt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AIQualityHQ uses deterministic static analysis rules and heuristic scanners, returning instant, 100% reproducible diagnostic scores in under 10 milliseconds without model hallucinations, rate limits, or API token costs."
          }
        },
        {
          "@type": "Question",
          "name": "Can AIQualityHQ protect against prompt injection and jailbreaks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Prompt Injection Scanner and AI Jailbreak Detector evaluate inputs against known attack vectors (DAN, role-play bypass, system prompt extraction, multi-turn activation drift) to ensure enterprise safety before shipping to production."
          }
        }
      ]
    }
  ]
};
---

<MarketingLayout title={pageTitle} description={pageDescription} canonicalUrl={siteUrl} image={ogImage}>
  <Header />

  <main id="main-content" class="flex-grow">
    <!-- Hero Section -->
    <section class="py-16 md:py-28 px-6 relative overflow-hidden">
      <!-- Subtle background radial gradient -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-primary/5 rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

      <div class="max-w-[1200px] mx-auto text-center flex flex-col items-center">
        <div class="flex flex-wrap items-center justify-center gap-3 mb-6">
          <a
            href="https://smolstartup.com/projects/aiqualityhq"
            target="_blank"
            rel="noopener noreferrer"
            title="Smol Startup Top 2 Daily Winner"
            class="inline-flex items-center transition-transform duration-fast hover:scale-105"
          >
            <img 
              src="https://r2.direasy-multi-tenant.focusapps.app/uploads/616d0b1a-3979-4b8c-94d1-b4f1fedd3ead/1783046772211/bzmx0zi15su/top2-light.svg" 
              alt="Smol Startup Top 2 Daily Winner" 
              width="195"
              height="45"
              class="h-9 w-auto object-contain"
              loading="eager"
              decoding="async"
            />
          </a>
          <span class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold uppercase tracking-widest text-primary bg-primary-subtle border border-primary-border px-3.5 py-2 rounded-xl">
            <Sparkles class="w-3.5 h-3.5" aria-hidden="true" />
            7 Production-Grade AI Quality Tools
          </span>
        </div>

        <h1 class="text-4xl md:text-5xl xl:text-6xl font-semibold tracking-tight text-text-primary max-w-4xl leading-[1.15] text-balance">
          Measure, Improve, and Trust Every AI Interaction.
        </h1>

        <!-- Live tool - visible on first visit -->
        <div class="mt-10 w-full max-w-[1000px] text-left">
          <HomeDemo client:load />
        </div>

        <p class="mt-12 text-base md:text-body-lg text-text-secondary max-w-2xl leading-relaxed">
          AIQualityHQ is a free, browser-native toolkit for AI developers, QA teams, and prompt engineers. Check, rewrite, and harden your prompts with a deterministic engine that runs entirely in your browser — 100% private, reproducible, and instant.
        </p>

        <p class="mt-4 text-sm text-text-secondary/80 max-w-2xl leading-relaxed font-sans">
          Who it's for: teams shipping LLM features — prompt engineers validating instructions, QA engineers testing reliability, and developers debugging prompt quality, injection risks, and jailbreak threats before production.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center gap-3">
          <Button href="/prompt-rewriter" size="lg" variant="primary">
            <Wand2 class="w-4 h-4 mr-2" aria-hidden="true" />
            Prompt Rewriter & Compiler
          </Button>
          <Button href="/checker" size="lg" variant="secondary" class="group flex items-center gap-1">
            Try Free Quality Checker
            <ArrowRight class="w-4 h-4 group-hover:translate-x-0.5 transition-fast" aria-hidden="true" />
          </Button>
        </div>
      </div>
    </section>

    <!-- Platform Highlights Bar -->
    <section class="border-y border-border-subtle bg-surface-secondary/40 py-8 px-6">
      <div class="max-w-[1200px] mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <div class="flex flex-col items-center">
            <p class="text-2xl font-bold text-text-primary font-mono tabular-nums">7 Tools</p>
            <p class="text-xs text-text-tertiary mt-1">Interactive AI applications</p>
          </div>
          <div class="flex flex-col items-center">
            <p class="text-2xl font-bold text-text-primary font-mono tabular-nums">6 Dimensions</p>
            <p class="text-xs text-text-tertiary mt-1">Deterministic rule engine</p>
          </div>
          <div class="flex flex-col items-center">
            <p class="text-2xl font-bold text-text-primary font-mono tabular-nums">&lt;10ms</p>
            <p class="text-xs text-text-tertiary mt-1">Instant browser execution</p>
          </div>
          <div class="flex flex-col items-center">
            <p class="text-2xl font-bold text-text-primary font-mono tabular-nums">100% Private</p>
            <p class="text-xs text-text-tertiary mt-1">Runs entirely client-side</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Recognition & Trust Band -->
    <section class="border-y border-border-subtle bg-surface-secondary/40 py-10 px-6">
      <div class="max-w-[1100px] mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 items-center">
          <div class="text-center md:text-left">
            <span class="font-mono text-xs font-semibold uppercase tracking-widest text-text-tertiary">
              Recognition
            </span>
            <p class="mt-1 text-sm text-text-secondary">Ranked by product-hunting communities for speed, privacy &amp; depth.</p>
          </div>
          <div class="flex flex-col items-center gap-1 text-center">
            <span class="text-2xl font-bold font-mono text-text-primary">Top 2</span>
            <span class="text-xs text-text-secondary">Smol Startup — Daily Winner</span>
          </div>
          <div class="flex flex-col items-center gap-1 text-center">
            <span class="text-2xl font-bold font-mono text-text-primary">6 Dimensions</span>
            <span class="text-xs text-text-secondary">Deterministic rule engine</span>
          </div>
          <div class="flex flex-col items-center gap-1 text-center">
            <span class="text-2xl font-bold font-mono text-text-primary">&lt;10ms</span>
            <span class="text-xs text-text-secondary">Average analysis time</span>
          </div>
        </div>
        <p class="mt-8 text-center text-[11px] text-text-tertiary max-w-2xl mx-auto">
          AIQualityHQ is independently listed across Shipstry, Launch List, Verified Tools, IndieHunt, Toolfio and EarlyHunt — no artificially inflated ratings or reviews.
        </p>
      </div>
    </section>

    <!-- Interactive AI Tools Suite Showcase Grid -->
    <section id="features" class="py-20 md:py-28 px-6 bg-canvas scroll-mt-16">
      <div class="max-w-[1200px] mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="font-mono text-xs font-semibold uppercase tracking-widest text-primary mb-3 block">
            Free Applications
          </span>
          <h2 class="text-3xl font-semibold tracking-tight text-text-primary">
            The Complete AIQualityHQ Suite
          </h2>
          <p class="mt-4 text-text-secondary text-sm md:text-base leading-relaxed">
            Purpose-built browser tools for prompt engineers, AI developers, and QA teams. Free to use with zero API keys or server transmission required.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Card 1: Prompt Rewriter & Compiler -->
          <Card class="p-6 flex flex-col justify-between gap-6 group hover:border-primary-border transition-all duration-fast bg-surface">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-lg bg-primary-subtle text-primary border border-primary-border shrink-0 group-hover:scale-105 transition-fast">
                  <Wand2 class="w-6 h-6" aria-hidden="true" />
                </div>
                <Badge variant="primary">New Feature</Badge>
              </div>
              <div>
                <h3 class="text-base font-semibold text-text-primary group-hover:text-primary transition-fast">
                  Prompt Rewriter & Compiler
                </h3>
                <p class="text-xs text-text-secondary mt-2 leading-relaxed">
                  Refactor raw prompts with target compilation tuned specifically for Claude 3.5, GPT-4o, and Gemini 2.0 Flash context windows.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-tertiary">LLM Target Compiler</span>
              <a href="/prompt-rewriter" class="text-xs font-semibold text-primary group-hover:text-primary-hover flex items-center gap-1">
                Open Tool <ChevronRight class="w-3.5 h-3.5" aria-hidden="true" />
              </a>
            </div>
          </Card>

          <!-- Card 2: System Prompt Generator -->
          <Card class="p-6 flex flex-col justify-between gap-6 group hover:border-primary-border transition-all duration-fast bg-surface">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-lg bg-primary-subtle text-primary border border-primary-border shrink-0 group-hover:scale-105 transition-fast">
                  <Sparkles class="w-6 h-6" aria-hidden="true" />
                </div>
                <Badge variant="success">Popular</Badge>
              </div>
              <div>
                <h3 class="text-base font-semibold text-text-primary group-hover:text-primary transition-fast">
                  AI System Prompt Generator
                </h3>
                <p class="text-xs text-text-secondary mt-2 leading-relaxed">
                  Synthesize production-grade system instructions with role parameters, target output JSON schemas, and anti-leakage constraints.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-tertiary">Role & Constraint Synthesizer</span>
              <a href="/ai-system-prompt-generator" class="text-xs font-semibold text-primary group-hover:text-primary-hover flex items-center gap-1">
                Open Tool <ChevronRight class="w-3.5 h-3.5" aria-hidden="true" />
              </a>
            </div>
          </Card>

          <!-- Card 3: Prompt Quality Checker -->
          <Card class="p-6 flex flex-col justify-between gap-6 group hover:border-primary-border transition-all duration-fast bg-surface">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-lg bg-primary-subtle text-primary border border-primary-border shrink-0 group-hover:scale-105 transition-fast">
                  <ShieldCheck class="w-6 h-6" aria-hidden="true" />
                </div>
                <Badge variant="success">Core Engine</Badge>
              </div>
              <div>
                <h3 class="text-base font-semibold text-text-primary group-hover:text-primary transition-fast">
                  Prompt Quality Checker
                </h3>
                <p class="text-xs text-text-secondary mt-2 leading-relaxed">
                  Score prompts across 6 core dimensions (structure, memory, context, accuracy, privacy, security) with instant static diagnostic rules.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-tertiary">6-Dimension Grading</span>
              <a href="/checker" class="text-xs font-semibold text-primary group-hover:text-primary-hover flex items-center gap-1">
                Open Tool <ChevronRight class="w-3.5 h-3.5" aria-hidden="true" />
              </a>
            </div>
          </Card>

          <!-- Card 4: Prompt Length & Token Optimizer -->
          <Card class="p-6 flex flex-col justify-between gap-6 group hover:border-primary-border transition-all duration-fast bg-surface">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-lg bg-primary-subtle text-primary border border-primary-border shrink-0 group-hover:scale-105 transition-fast">
                  <Scissors class="w-6 h-6" aria-hidden="true" />
                </div>
                <Badge variant="warning">Cost Saver</Badge>
              </div>
              <div>
                <h3 class="text-base font-semibold text-text-primary group-hover:text-primary transition-fast">
                  Length & Token Optimizer
                </h3>
                <p class="text-xs text-text-secondary mt-2 leading-relaxed">
                  Heuristic token reduction, fluff removal, prompt trimming, and multi-model cost estimation for OpenAI, Claude, and Gemini APIs.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-tertiary">Token & Cost Trimming</span>
              <a href="/prompt-length-optimizer" class="text-xs font-semibold text-primary group-hover:text-primary-hover flex items-center gap-1">
                Open Tool <ChevronRight class="w-3.5 h-3.5" aria-hidden="true" />
              </a>
            </div>
          </Card>

          <!-- Card 5: Prompt Injection Scanner -->
          <Card class="p-6 flex flex-col justify-between gap-6 group hover:border-primary-border transition-all duration-fast bg-surface">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-lg bg-primary-subtle text-primary border border-primary-border shrink-0 group-hover:scale-105 transition-fast">
                  <ShieldAlert class="w-6 h-6" aria-hidden="true" />
                </div>
                <Badge variant="critical">Security Red-Team</Badge>
              </div>
              <div>
                <h3 class="text-base font-semibold text-text-primary group-hover:text-primary transition-fast">
                  Prompt Injection Scanner
                </h3>
                <p class="text-xs text-text-secondary mt-2 leading-relaxed">
                  Red-team prompts against multi-vector injection attacks, instruction override tricks, DAN jailbreak patterns, and system leakage.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-tertiary">Exploit Guardrails</span>
              <a href="/prompt-injection-scanner" class="text-xs font-semibold text-primary group-hover:text-primary-hover flex items-center gap-1">
                Open Tool <ChevronRight class="w-3.5 h-3.5" aria-hidden="true" />
              </a>
            </div>
          </Card>

          <!-- Card 6: AI Jailbreak Detector -->
          <Card class="p-6 flex flex-col justify-between gap-6 group hover:border-primary-border transition-all duration-fast bg-surface">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-lg bg-primary-subtle text-primary border border-primary-border shrink-0 group-hover:scale-105 transition-fast">
                  <Shield class="w-6 h-6" aria-hidden="true" />
                </div>
                <Badge variant="critical">Edge Defense</Badge>
              </div>
              <div>
                <h3 class="text-base font-semibold text-text-primary group-hover:text-primary transition-fast">
                  AI Jailbreak Detector
                </h3>
                <p class="text-xs text-text-secondary mt-2 leading-relaxed">
                  Enterprise threat scanner featuring 4-tier hybrid edge analysis, multi-turn activation drift detection, and cryptographic attestation.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-tertiary">Sub-25ms Threat Scan</span>
              <a href="/jailbreak-detector" class="text-xs font-semibold text-primary group-hover:text-primary-hover flex items-center gap-1">
                Open Tool <ChevronRight class="w-3.5 h-3.5" aria-hidden="true" />
              </a>
            </div>
          </Card>

          <!-- Card 7: AI Visibility Scorecard & Auditor -->
          <Card class="p-6 flex flex-col justify-between gap-6 group hover:border-primary-border transition-all duration-fast bg-surface">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-lg bg-primary-subtle text-primary border border-primary-border shrink-0 group-hover:scale-105 transition-fast">
                  <Brain class="w-6 h-6" aria-hidden="true" />
                </div>
                <Badge variant="primary">Enterprise Audit</Badge>
              </div>
              <div>
                <h3 class="text-base font-semibold text-text-primary group-hover:text-primary transition-fast">
                  AI Visibility & LLM Auditor
                </h3>
                <p class="text-xs text-text-secondary mt-2 leading-relaxed">
                  Evaluate website LLM readiness, validate llms.txt standard files, and audit frontier model response accuracy and hallucination risks.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-tertiary">llms.txt & GEO Scorecard</span>
              <a href="/ai-audit" class="text-xs font-semibold text-primary group-hover:text-primary-hover flex items-center gap-1">
                Open Tool <ChevronRight class="w-3.5 h-3.5" aria-hidden="true" />
              </a>
            </div>
          </Card>

          <!-- Card 8: AI Testing Suite & Frameworks -->
          <Card class="p-6 flex flex-col justify-between gap-6 group hover:border-primary-border transition-all duration-fast bg-surface">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-lg bg-primary-subtle text-primary border border-primary-border shrink-0 group-hover:scale-105 transition-fast">
                  <Layers class="w-6 h-6" aria-hidden="true" />
                </div>
                <Badge variant="secondary">Testing Specs</Badge>
              </div>
              <div>
                <h3 class="text-base font-semibold text-text-primary group-hover:text-primary transition-fast">
                  AI Software Testing Guides
                </h3>
                <p class="text-xs text-text-secondary mt-2 leading-relaxed">
                  Comprehensive architectural guides, test automation strategies, and Generative Engine Optimization (GEO) technical frameworks.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-tertiary">QA & GEO Tutorials</span>
              <a href="/artificial-intelligence-testing" class="text-xs font-semibold text-primary group-hover:text-primary-hover flex items-center gap-1">
                Explore Guides <ChevronRight class="w-3.5 h-3.5" aria-hidden="true" />
              </a>
            </div>
          </Card>
        </div>
      </div>
    </section>

    <!-- Comparison / Benchmark Section -->
    <section id="compare" class="py-20 md:py-28 px-6 bg-canvas border-b border-border-subtle scroll-mt-16">
      <div class="max-w-[1080px] mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="font-mono text-xs font-semibold uppercase tracking-widest text-primary mb-3 block">How it Compares</span>
          <h2 class="text-3xl font-semibold tracking-tight text-text-primary">
            Deterministic. Private. Instant. By Design.
          </h2>
          <p class="mt-4 text-text-secondary text-sm md:text-base leading-relaxed">
            Most "prompt graders" are just another LLM call — the AI grades your prompt with more AI, sending your data to a server at a per-token cost. AIQualityHQ is built differently: a rules-based engine that runs entirely in your browser.
