---
// src/pages/index.astro
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import MockDashboard from '../components/marketing/MockDashboard.astro';
import {
  MessageSquare, Brain, Layers, Shield, Lock, ShieldCheck,
  ArrowRight, Zap, Search, Scissors, ShieldAlert, Sparkles,
  FileText, ChevronRight, CheckCircle2, Sliders, Cpu, Activity
} from '@lucide/astro';

const siteUrl = "https://aiqualityhq.com";

const pageTitle = "AIQualityHQ — Free AI Prompt Quality Checker & LLM Tool Suite";
const pageDescription = "Free AI prompt quality checker and LLM tool suite. Generate system prompts, optimize prompt length, scan for prompt injection attacks, and audit AI test automation.";
const ogImage = `${siteUrl}/og-checker.png`;

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "AIQualityHQ Prompt Quality & AI Tool Suite",
      "description": pageDescription,
      "url": siteUrl,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "ratingCount": "142",
        "bestRating": "5",
        "worstRating": "1"
      },
      "featureList": "System Prompt Generation, Deterministic Prompt Quality Checking, Prompt Length Optimization, Prompt Injection Scanning, AI Response Auditing, AI Software Testing Guides"
    },
    {
      "@type": "ItemList",
      "name": "AIQualityHQ Free AI Tool Suite",
      "description": "Complete collection of browser-native prompt engineering and AI quality testing applications.",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "AI System Prompt Generator",
          "url": `${siteUrl}/ai-system-prompt-generator`,
          "description": "Synthesize production-grade LLM system instructions with role definitions, output schemas, and security locks."
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Prompt Quality Checker",
          "url": `${siteUrl}/checker`,
          "description": "6-dimension deterministic quality scoring engine evaluating structure, memory, context, accuracy, privacy, and security."
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Prompt Length & Token Optimizer",
          "url": `${siteUrl}/prompt-length-optimizer`,
          "description": "Heuristic token reduction, prompt trimming, and multi-provider LLM API cost estimation."
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Prompt Injection Security Scanner",
          "url": `${siteUrl}/prompt-injection-scanner`,
          "description": "Red-team prompts against multi-vector injection attacks, DAN jailbreak patterns, and system instruction leakage."
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "AI Auditor Tool",
          "url": `${siteUrl}/ai-audit`,
          "description": "Enterprise audit engine for LLM output accuracy, hallucination detection, and automated test execution metrics."
        },
        {
          "@type": "ListItem",
          "position": 6,
          "name": "AI Software Testing Suite",
          "url": `${siteUrl}/artificial-intelligence-testing`,
          "description": "Comprehensive framework and tutorials for testing AI applications, LLM pipelines, and test automation."
        }
      ]
    },
    {
      "@type": "WebSite",
      "name": "AIQualityHQ",
      "url": siteUrl,
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${siteUrl}/search?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "name": "AIQualityHQ",
      "url": siteUrl,
      "logo": `${siteUrl}/aiqualityhq-logo.png`,
      "description": "AI Quality HQ helps developers and AI engineers measure, improve, and trust every AI interaction with deterministic prompt tools."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What tools are included in AIQualityHQ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AIQualityHQ includes five free interactive applications: AI System Prompt Generator, Prompt Quality Checker, Prompt Length & Token Optimizer, Prompt Injection Security Scanner, and the AI Auditor Tool, along with dedicated AI software testing guides."
          }
        },
        {
          "@type": "Question",
          "name": "Is my prompt data private and secure?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. All AIQualityHQ tools run 100% client-side in your browser using local JavaScript. No prompt text, system instructions, or analysis results are transmitted to external servers, making it safe for proprietary enterprise and regulated workflows."
          }
        },
        {
          "@type": "Question",
          "name": "How is AIQualityHQ different from asking an LLM to review my prompt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AIQualityHQ relies on deterministic static analysis rules, producing identical, reproducible scores in under 10 milliseconds without model hallucinations, API costs, or data privacy risks."
          }
        }
      ]
    }
  ]
};
---

<MarketingLayout title={pageTitle} description={pageDescription} canonicalUrl={siteUrl} image={ogImage}>
  <Header />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="py-16 md:py-28 px-6 relative overflow-hidden">
      <!-- Subtle background radial gradient -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-primary/5 rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

      <div class="max-w-[1200px] mx-auto text-center flex flex-col items-center">
        <span class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold uppercase tracking-widest text-primary mb-4 bg-primary-subtle border border-primary-border px-3.5 py-1.5 rounded-full">
          <Sparkles class="w-3.5 h-3.5" />
          Production-Grade AI Quality Platform
        </span>

        <h1 class="text-4xl md:text-display-2xl font-semibold tracking-tight text-text-primary max-w-4xl leading-[1.15]">
          Measure, Improve, and Trust Every AI Interaction.
        </h1>

        <p class="mt-6 text-base md:text-body-lg text-text-secondary max-w-2xl leading-relaxed">
          Free, browser-native suite of deterministic AI prompt tools — generate system prompts, audit quality across 6 dimensions, optimize token costs, and scan for security vulnerabilities in under 10ms.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center gap-3">
          <Button href="/ai-system-prompt-generator" size="lg" variant="primary">
            <Sparkles class="w-4 h-4 mr-2" />
            System Prompt Generator
          </Button>
          <Button href="/checker" size="lg" variant="secondary" class="group flex items-center gap-1">
            Try Free Prompt Checker
            <ArrowRight class="w-4 h-4 group-hover:translate-x-0.5 transition-fast" />
          </Button>
        </div>

        <!-- Dashboard Mock Preview -->
        <div class="mt-14 w-full max-w-[1000px] transition-slow hover:-translate-y-1">
          <MockDashboard />
        </div>
      </div>
    </section>

    <!-- Platform Highlights Bar -->
    <section class="border-y border-border-subtle bg-surface-secondary/40 py-8 px-6">
      <div class="max-w-[1200px] mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <div class="flex flex-col items-center">
            <p class="text-2xl font-bold text-text-primary font-mono">5 Tools</p>
            <p class="text-xs text-text-tertiary mt-1">Interactive AI suite</p>
          </div>
          <div class="flex flex-col items-center">
            <p class="text-2xl font-bold text-text-primary font-mono">6 Dimensions</p>
            <p class="text-xs text-text-tertiary mt-1">Deterministic rule engine</p>
          </div>
          <div class="flex flex-col items-center">
            <p class="text-2xl font-bold text-text-primary font-mono">&lt;10ms</p>
            <p class="text-xs text-text-tertiary mt-1">Instant analysis execution</p>
          </div>
          <div class="flex flex-col items-center">
            <p class="text-2xl font-bold text-text-primary font-mono">100% Private</p>
            <p class="text-xs text-text-tertiary mt-1">Runs entirely in browser</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive AI Tools Suite Showcase -->
    <section id="tools" class="py-20 md:py-28 px-6 bg-canvas">
      <div class="max-w-[1200px] mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="font-mono text-xs font-semibold uppercase tracking-widest text-primary mb-3 block">
            Free Applications
          </span>
          <h2 class="text-3xl font-semibold tracking-tight text-text-primary">
            The AIQualityHQ Tool Suite
          </h2>
          <p class="mt-4 text-text-secondary text-sm md:text-base leading-relaxed">
            Purpose-built applications designed for prompt engineers, AI developers, and QA teams. Free to use with zero API keys required.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Card 1: System Prompt Generator -->
          <Card class="p-6 flex flex-col justify-between gap-6 group hover:border-primary-border transition-all duration-fast">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-lg bg-primary-subtle text-primary border border-primary-border shrink-0 group-hover:scale-105 transition-fast">
                  <Sparkles class="w-6 h-6" />
                </div>
                <Badge variant="primary">New Feature</Badge>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-text-primary group-hover:text-primary transition-fast">
                  AI System Prompt Generator
                </h3>
                <p class="text-xs md:text-sm text-text-secondary mt-2 leading-relaxed">
                  Synthesize production-grade LLM system instructions with explicit role definitions, target schemas, behavioral bounds, and security locks.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-tertiary">Role &amp; Constraint Synthesizer</span>
              <a href="/ai-system-prompt-generator" class="text-xs font-semibold text-primary group-hover:text-primary-hover flex items-center gap-1">
                Open Tool <ChevronRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </Card>

          <!-- Card 2: Prompt Quality Checker -->
          <Card class="p-6 flex flex-col justify-between gap-6 group hover:border-primary-border transition-all duration-fast">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-lg bg-primary-subtle text-primary border border-primary-border shrink-0 group-hover:scale-105 transition-fast">
                  <ShieldCheck class="w-6 h-6" />
                </div>
                <Badge variant="success">Core Tool</Badge>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-text-primary group-hover:text-primary transition-fast">
                  Prompt Quality Checker
                </h3>
                <p class="text-xs md:text-sm text-text-secondary mt-2 leading-relaxed">
                  Evaluate prompts across 6 core dimensions (structure, memory, context, accuracy, privacy, security) with instant rule diagnostic diagnostics.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-tertiary">6-Dimension Diagnostics</span>
              <a href="/checker" class="text-xs font-semibold text-primary group-hover:text-primary-hover flex items-center gap-1">
                Open Tool <ChevronRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </Card>

          <!-- Card 3: Prompt Optimizer -->
          <Card class="p-6 flex flex-col justify-between gap-6 group hover:border-primary-border transition-all duration-fast">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-lg bg-primary-subtle text-primary border border-primary-border shrink-0 group-hover:scale-105 transition-fast">
                  <Scissors class="w-6 h-6" />
                </div>
                <Badge variant="warning">Cost Saver</Badge>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-text-primary group-hover:text-primary transition-fast">
                  Prompt Length &amp; Token Optimizer
                </h3>
                <p class="text-xs md:text-sm text-text-secondary mt-2 leading-relaxed">
                  Heuristic token reduction, filler word removal, and multi-model cost estimation for OpenAI GPT-4o, Claude 3.5, and Gemini.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-tertiary">Token &amp; Cost Reduction</span>
              <a href="/prompt-length-optimizer" class="text-xs font-semibold text-primary group-hover:text-primary-hover flex items-center gap-1">
                Open Tool <ChevronRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </Card>

          <!-- Card 4: Injection Scanner -->
          <Card class="p-6 flex flex-col justify-between gap-6 group hover:border-primary-border transition-all duration-fast">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-lg bg-primary-subtle text-primary border border-primary-border shrink-0 group-hover:scale-105 transition-fast">
                  <ShieldAlert class="w-6 h-6" />
                </div>
                <Badge variant="critical">Security Red-Team</Badge>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-text-primary group-hover:text-primary transition-fast">
                  Prompt Injection Scanner
                </h3>
                <p class="text-xs md:text-sm text-text-secondary mt-2 leading-relaxed">
                  Scan prompts for multi-vector injection vulnerabilities, DAN jailbreaks, instruction overrides, and system prompt leakage risks.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-tertiary">Jailbreak Guardrails</span>
              <a href="/prompt-injection-scanner" class="text-xs font-semibold text-primary group-hover:text-primary-hover flex items-center gap-1">
                Open Tool <ChevronRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </Card>

          <!-- Card 5: AI Auditor -->
          <Card class="p-6 flex flex-col justify-between gap-6 group hover:border-primary-border transition-all duration-fast">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-lg bg-primary-subtle text-primary border border-primary-border shrink-0 group-hover:scale-105 transition-fast">
                  <Brain class="w-6 h-6" />
                </div>
                <Badge variant="primary">Enterprise Audit</Badge>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-text-primary group-hover:text-primary transition-fast">
                  AI Auditor Tool
                </h3>
                <p class="text-xs md:text-sm text-text-secondary mt-2 leading-relaxed">
                  Audit LLM response accuracy, context grounding alignment, hallucination frequency, and test automation execution metrics.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-tertiary">Response Benchmarking</span>
              <a href="/ai-audit" class="text-xs font-semibold text-primary group-hover:text-primary-hover flex items-center gap-1">
                Open Tool <ChevronRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </Card>

          <!-- Card 6: AI Testing Suite -->
          <Card class="p-6 flex flex-col justify-between gap-6 group hover:border-primary-border transition-all duration-fast">
            <div class="flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-lg bg-primary-subtle text-primary border border-primary-border shrink-0 group-hover:scale-105 transition-fast">
                  <Layers class="w-6 h-6" />
                </div>
                <Badge variant="secondary">Framework &amp; Guides</Badge>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-text-primary group-hover:text-primary transition-fast">
                  AI Software Testing Suite
                </h3>
                <p class="text-xs md:text-sm text-text-secondary mt-2 leading-relaxed">
                  Comprehensive guidelines and frameworks for automated testing of AI models, agentic workflows, and LLM pipelines.
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-border-subtle flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-tertiary">Testing Guides &amp; Specs</span>
              <a href="/artificial-intelligence-testing" class="text-xs font-semibold text-primary group-hover:text-primary-hover flex items-center gap-1">
                Explore Guides <ChevronRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </Card>
        </div>
      </div>
    </section>

    <!-- Problem vs Solution Section -->
    <section class="py-20 md:py-28 px-6 bg-surface-secondary/20 border-y border-border-subtle">
      <div class="max-w-[1200px] mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="font-mono text-xs font-semibold uppercase tracking-widest text-primary mb-3 block">The Problem</span>
            <h2 class="text-3xl font-semibold tracking-tight text-text-primary leading-tight">
              Unchecked AI prompts cost teams time, token budgets, and user trust.
            </h2>
            <p class="mt-4 text-text-secondary text-sm md:text-base leading-relaxed">
              Vague prompt instructions, missing role constraints, and ungrounded context result in hallucinated outputs, security leaks, and unpredictable app behavior. Without validation, developers ship blind.
            </p>
            <ul class="mt-6 flex flex-col gap-3">
              <li class="flex items-start gap-3 text-sm text-text-secondary">
                <span class="w-2 h-2 rounded-full bg-critical shrink-0 mt-1.5" />
                <span><strong>Prompt Injection Vectors:</strong> Malicious user input hijacking system behavior.</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-text-secondary">
                <span class="w-2 h-2 rounded-full bg-critical shrink-0 mt-1.5" />
                <span><strong>Token Bloat &amp; Cost Overhead:</strong> Verbose prompts burning context windows unnecessarily.</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-text-secondary">
                <span class="w-2 h-2 rounded-full bg-critical shrink-0 mt-1.5" />
                <span><strong>PII &amp; Data Exposure:</strong> Raw customer variables exposed without sanitization locks.</span>
              </li>
            </ul>
          </div>

          <div class="bg-surface rounded-2xl border border-border p-8 shadow-floating">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-border-subtle">
              <div class="p-2 rounded bg-primary-subtle text-primary">
                <Activity class="w-5 h-5" />
              </div>
              <div>
                <h3 class="text-sm font-semibold text-text-primary">Deterministic Quality Engine</h3>
                <p class="text-[11px] text-text-tertiary">Static heuristic analysis vs LLM randomness</p>
              </div>
            </div>

            <div class="space-y-3 font-mono text-xs">
              <div class="flex items-center justify-between p-3 rounded-lg bg-surface-secondary/50 border border-border-subtle">
                <span class="text-text-secondary">Execution Latency</span>
                <span class="text-success font-semibold">&lt; 10 ms (Browser Native)</span>
              </div>
              <div class="flex items-center justify-between p-3 rounded-lg bg-surface-secondary/50 border border-border-subtle">
                <span class="text-text-secondary">API Cost / Rate Limits</span>
                <span class="text-success font-semibold">$0.00 (Zero Dependency)</span>
              </div>
              <div class="flex items-center justify-between p-3 rounded-lg bg-surface-secondary/50 border border-border-subtle">
                <span class="text-text-secondary">Data Privacy Guarantee</span>
                <span class="text-success font-semibold">100% Client-Side Isolated</span>
              </div>
              <div class="flex items-center justify-between p-3 rounded-lg bg-surface-secondary/50 border border-border-subtle">
                <span class="text-text-secondary">Score Reproducibility</span>
                <span class="text-success font-semibold">Deterministic (100% Consistent)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Six Core Quality Dimensions -->
    <section id="dimensions" class="py-20 md:py-28 px-6 bg-canvas scroll-mt-16">
      <div class="max-w-[1200px] mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="font-mono text-xs font-semibold uppercase tracking-widest text-primary mb-3 block">Evaluation Criteria</span>
          <h2 class="text-3xl font-semibold tracking-tight text-text-primary">Six Core Dimensions of Prompt Quality</h2>
          <p class="mt-4 text-text-secondary text-sm md:text-base leading-relaxed">
            Every prompt checked in AIQualityHQ is graded against six deterministic dimensions to isolate vulnerabilities and ensure output precision.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <Card class="p-6 flex flex-col gap-4 bg-surface hover:shadow-subtle hover:border-border-strong transition-default">
            <div class="flex items-center justify-between">
              <MessageSquare class="w-8 h-8 p-2 rounded bg-primary-subtle text-primary shrink-0" />
              <Badge variant="success">Structural Integrity</Badge>
            </div>
            <div>
              <h3 class="text-base font-semibold text-text-primary">1. Prompt Structure</h3>
              <p class="text-xs text-text-secondary mt-1.5 leading-relaxed">
                Validates role assignments, task demarcation, formatting delimiters, explicit output specifications, and structural clarity.
              </p>
            </div>
          </Card>

          <Card class="p-6 flex flex-col gap-4 bg-surface hover:shadow-subtle hover:border-border-strong transition-default">
            <div class="flex items-center justify-between">
              <Brain class="w-8 h-8 p-2 rounded bg-primary-subtle text-primary shrink-0" />
              <Badge variant="primary">Contextual State</Badge>
            </div>
            <div>
              <h3 class="text-base font-semibold text-text-primary">2. Memory &amp; State</h3>
              <p class="text-xs text-text-secondary mt-1.5 leading-relaxed">
                Evaluates how effectively conversational history and variable context are referenced without overloading token windows.
              </p>
            </div>
          </Card>

          <Card class="p-6 flex flex-col gap-4 bg-surface hover:shadow-subtle hover:border-border-strong transition-default">
            <div class="flex items-center justify-between">
              <Layers class="w-8 h-8 p-2 rounded bg-primary-subtle text-primary shrink-0" />
              <Badge variant="success">RAG Grounding</Badge>
            </div>
            <div>
              <h3 class="text-base font-semibold text-text-primary">3. Context Grounding</h3>
              <p class="text-xs text-text-secondary mt-1.5 leading-relaxed">
                Measures document retrieval parameters, citation requirements, and grounding constraints to prevent out-of-bounds answers.
              </p>
            </div>
          </Card>

          <Card class="p-6 flex flex-col gap-4 bg-surface hover:shadow-subtle hover:border-border-strong transition-default">
            <div class="flex items-center justify-between">
              <Shield class="w-8 h-8 p-2 rounded bg-primary-subtle text-primary shrink-0" />
              <Badge variant="warning">Hallucination Risk</Badge>
            </div>
            <div>
              <h3 class="text-base font-semibold text-text-primary">4. Trust &amp; Accuracy</h3>
              <p class="text-xs text-text-secondary mt-1.5 leading-relaxed">
                Flags ambiguous instructions, unverified assumptions, and factual grounding gaps that contribute to hallucinated LLM responses.
              </p>
            </div>
          </Card>

          <Card class="p-6 flex flex-col gap-4 bg-surface hover:shadow-subtle hover:border-border-strong transition-default">
            <div class="flex items-center justify-between">
              <Lock class="w-8 h-8 p-2 rounded bg-primary-subtle text-primary shrink-0" />
              <Badge variant="success">Data Protection</Badge>
            </div>
            <div>
              <h3 class="text-base font-semibold text-text-primary">5. PII &amp; Privacy</h3>
              <p class="text-xs text-text-secondary mt-1.5 leading-relaxed">
                Detects exposed email addresses, API tokens, phone numbers, and raw user variables requiring sanitization.
              </p>
