<style>
  .indie-deals-badge {
    position: relative;
    overflow: hidden;
    display: inline-block;
  }
  .indie-deals-badge::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, 
      rgba(255,255,255,0) 0%, 
      rgba(255,255,255,0) 40%, 
      rgba(255,255,255,0.9) 50%, 
      rgba(255,255,255,0) 60%, 
      rgba(255,255,255,0) 100%);
    transform: translateX(-100%) rotate(45deg);
    pointer-events: none;
    transition: transform 0.3s ease-out;
  }
  .indie-deals-badge:hover::after {
    animation: indie-deals-shine 1s ease-out;
  }
  @keyframes indie-deals-shine {
    0% { transform: translateX(-100%) rotate(45deg); }
    50% { transform: translateX(0%) rotate(45deg); }
    100% { transform: translateX(100%) rotate(45deg); }
  }

  [data-marquee-track] a,
  [data-marquee-track] [data-codemarket-widget] {
    filter: saturate(30%) opacity(0.45);
    transition: filter 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-marquee-track] a:hover,
  [data-marquee-track] [data-codemarket-widget]:hover {
    filter: saturate(100%) opacity(1);
    transform: scale(1.05);
  }
</style>

<script>
  const track = document.querySelector('[data-marquee-track]');
  if (track) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!prefersReducedMotion.matches) {
      track.style.animation = 'none';

      let half = 0;
      const measure = () => { half = track.scrollWidth / 2; };
      measure();

      let x = 0;
      let playing = true;
      let last = performance.now();
      const duration = 160;
      const speed = () => (half > 0 ? half / duration : 0);

      const group = track.closest('.group');
      if (group) {
        group.addEventListener('mouseenter', () => { playing = false; });
        group.addEventListener('mouseleave', () => { playing = true; });
      }

      const reMeasure = () => requestAnimationFrame(measure);
      track.querySelectorAll('img').forEach((img) => {
        if (img.complete) reMeasure();
        else img.addEventListener('load', reMeasure, { once: true });
      });
      window.addEventListener('resize', reMeasure);

      function frame(now) {
        const dt = Math.min((now - last) / 1000, 0.1);
        last = now;
        if (playing && half > 0) {
          x -= speed() * dt;
          if (x <= -half) x += half;
          track.style.transform = `translate3d(${x}px, 0, 0)`;
        }
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }
  }
</script>
