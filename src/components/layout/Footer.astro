---
// src/components/layout/Footer.astro
import { ExternalLink } from '@lucide/astro';
const currentYear = new Date().getFullYear();
---
<footer class="w-full bg-canvas border-t border-border-subtle pt-16 pb-8 transition-fast mt-auto">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Col 1: Brand -->
      <div class="flex flex-col gap-3">
        <span class="flex items-center gap-2 font-sans font-semibold text-lg tracking-tight text-text-primary">
          <img src="/aiqualityhq-logo.svg" alt="AIQualityHQ Logo" class="w-6 h-6 shrink-0" width="24" height="24" />
          <span>AIQuality<span class="text-primary">HQ</span></span>
        </span>
        <p class="text-xs text-text-secondary max-w-[200px] leading-relaxed font-sans">
          Help people measure, improve, and trust every AI interaction.
        </p>
        <div class="pt-2">
          <a href="https://smollaunchpad.com/projects/aiqualityhq" target="_blank" rel="noopener noreferrer" title="Smol LaunchPad Top 3 Daily Winner" class="inline-block transition-fast hover:opacity-90">
            <img 
              src="https://r2.direasy-multi-tenant.focusapps.app/uploads/616d0b1a-3979-4b8c-94d1-b4f1fedd3ead/1783046779158/zcvx4nmzj8g/top3-light.svg" 
              alt="Smol LaunchPad Top 3 Daily Winner" 
              style="width: 195px; height: auto;" 
              width="195"
              height="42"
            />
          </a>
        </div>
      </div>

      <!-- Col 2: Product -->
      <div>
        <h3 class="text-xs font-semibold text-text-primary mb-4 uppercase tracking-wider">Product</h3>
        <ul class="flex flex-col gap-1">
          <li><a href="/prompt-rewriter" class="text-xs text-text-secondary hover:text-text-primary transition-fast font-medium text-primary py-1 inline-block">Prompt Rewriter & Compiler</a></li>
          <li><a href="/ai-system-prompt-generator" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">AI System Prompt Generator</a></li>
          <li><a href="/checker" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">Prompt Checker</a></li>
          <li><a href="/prompt-length-optimizer" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">Prompt Length Optimizer</a></li>
          <li><a href="/prompt-injection-scanner" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">Prompt Injection Scanner</a></li>
          <li><a href="/jailbreak-detector" class="text-xs text-text-secondary hover:text-text-primary transition-fast font-medium text-primary py-1 inline-block">AI Jailbreak Detector</a></li>
          <li><a href="/ai-audit" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">AI Auditor tool</a></li>
        </ul>
      </div>

      <!-- Col 3: Resources -->
      <div>
        <h3 class="text-xs font-semibold text-text-primary mb-4 uppercase tracking-wider">Resources</h3>
        <ul class="flex flex-col gap-1">
          <li><a href="/about" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">About Us</a></li>
          <li><a href="/how-it-was-built" class="text-xs text-text-secondary hover:text-text-primary transition-fast font-medium text-primary/90 py-1 inline-block">Tech Stack & Resources</a></li>
          <li><a href="/docs" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">Documentation</a></li>
          <li><a href="/articles" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">Articles & Guides</a></li>
          <li><a href="/faq" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">FAQ</a></li>
          <li><a href="/#dimensions" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">Quality Dimensions</a></li>
          <li><a href="/partners" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">Partners & Tools</a></li>
          <li><a href="/sitemap.xml" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">Sitemap</a></li>
        </ul>
      </div>


      <!-- Col 4: Legal -->
      <div>
        <h3 class="text-xs font-semibold text-text-primary mb-4 uppercase tracking-wider">Legal</h3>
        <ul class="flex flex-col gap-1">
          <li><a href="/privacy" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">Privacy Policy</a></li>
          <li><a href="/terms" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">Terms of Service</a></li>
          <li><a href="/contact" class="text-xs text-text-secondary hover:text-text-primary transition-fast py-1 inline-block">Contact Us</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom strip -->
    <div class="border-t border-border-subtle mt-12 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="text-xs text-text-tertiary">
        &copy; {currentYear} AIQualityHQ. All rights reserved.
      </span>
      <span class="text-xs text-text-tertiary flex items-center gap-3 font-sans select-none">
        <span>Designed for trust and precision.</span>
        <span class="text-text-disabled">|</span>
        <span class="text-[11px] text-text-tertiary">Share AIQualityHQ:</span>
        <a 
          href="https://twitter.com/intent/tweet?text=Check%20out%20AIQualityHQ%20%E2%80%94%20a%20free%20tool%20to%20measure%2C%20improve%2C%20and%20trust%20every%20AI%20prompt%20interaction%21&url=https%3A%2F%2Faiqualityhq.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-text-primary transition-fast px-2 py-1 inline-flex items-center justify-center min-h-[32px] rounded border border-border-subtle bg-surface-secondary/40 hover:bg-surface-secondary text-[11px]"
          title="Share on X"
          aria-label="Share on X"
        >
          X
        </a>
        <a 
          href="https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Faiqualityhq.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-text-primary transition-fast px-2 py-1 inline-flex items-center justify-center min-h-[32px] rounded border border-border-subtle bg-surface-secondary/40 hover:bg-surface-secondary text-[11px]"
          title="Share on LinkedIn"
          aria-label="Share on LinkedIn"
        >
          LinkedIn
        </a>
        <a 
          href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Faiqualityhq.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-text-primary transition-fast px-2 py-1 inline-flex items-center justify-center min-h-[32px] rounded border border-border-subtle bg-surface-secondary/40 hover:bg-surface-secondary text-[11px]"
          title="Share on Facebook"
          aria-label="Share on Facebook"
        >
          Facebook
        </a>
      </span>
    </div>

    
