---
// src/components/layout/Header.astro
import ThemeToggle from '../common/ThemeToggle.astro';
import Button from '../ui/Button.astro';
import { Menu, User, ChevronDown, ShieldCheck, Scissors, ShieldAlert, Shield, Brain, FileText, BookOpen, Layers, Sparkles, Wand2 } from '@lucide/astro';

interface Props {
  activeNav?: string;
}

const { activeNav } = Astro.props;

const isToolsActive = ['checker', 'prompt-optimizer', 'injection-scanner', 'jailbreak-detector', 'ai-audit', 'system-prompt-generator', 'prompt-rewriter'].includes(activeNav || '');
---
<header class="sticky top-0 z-40 w-full h-16 border-b border-border-subtle bg-canvas/90 backdrop-blur-md transition-fast shadow-subtle">
  <div class="max-w-[1200px] h-full mx-auto px-6 flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group shrink-0" aria-label="AIQualityHQ Home">
      <img src="/aiqualityhq-logo.svg" alt="AIQualityHQ Logo" class="w-6 h-6 shrink-0" width="24" height="24" />
      <span class="font-sans font-semibold text-lg tracking-tight text-text-primary">
        AIQuality<span class="text-primary group-hover:text-primary-hover transition-fast">HQ</span>
      </span>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Main navigation">
      <!-- Tools Mega Dropdown -->
      <div class="relative group" id="tools-dropdown-container">
        <button
          id="tools-dropdown-btn"
          class:list={[
            "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-medium transition-fast cursor-pointer select-none",
            isToolsActive ? 'text-primary bg-primary-subtle/60 font-semibold' : 'text-text-secondary hover:text-text-primary hover:bg-surface-secondary'
          ]}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="tools-dropdown-menu"
        >
          <span>Tools & Applications</span>
          <ChevronDown id="tools-dropdown-chevron" class="w-3.5 h-3.5 text-text-tertiary transition-transform duration-fast" />
        </button>

        <!-- Dropdown Menu Card -->
        <div
          id="tools-dropdown-menu"
          class="absolute left-0 top-full mt-2 w-80 rounded-xl border border-border bg-surface shadow-floating p-2 z-50 invisible opacity-0 translate-y-1 transition-all duration-fast"
          role="menu"
          aria-labelledby="tools-dropdown-btn"
        >
          <div class="px-3 py-2 text-[10px] font-mono font-semibold uppercase tracking-widest text-text-tertiary border-b border-border-subtle mb-1">
            Free AI Quality Tools
          </div>

          <a
            href="/prompt-rewriter"
            class:list={[
              "flex items-start gap-3 p-2.5 rounded-lg transition-fast hover:bg-surface-secondary group/item",
              activeNav === 'prompt-rewriter' ? 'bg-primary-subtle/40' : ''
            ]}
            role="menuitem"
          >
            <div class="p-2 rounded-md bg-primary-subtle text-primary shrink-0 mt-0.5 group-hover/item:scale-105 transition-fast">
              <Wand2 class="w-4 h-4" />
            </div>
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover/item:text-primary transition-fast">
                Prompt Rewriter & Compiler
              </div>
              <div class="text-[11px] text-text-tertiary mt-0.5 leading-snug">
                Target compilation for Claude, Gemini & GPT
              </div>
            </div>
          </a>

          <a
            href="/ai-system-prompt-generator"
            class:list={[
              "flex items-start gap-3 p-2.5 rounded-lg transition-fast hover:bg-surface-secondary group/item",
              activeNav === 'system-prompt-generator' ? 'bg-primary-subtle/40' : ''
            ]}
            role="menuitem"
          >
            <div class="p-2 rounded-md bg-primary-subtle text-primary shrink-0 mt-0.5 group-hover/item:scale-105 transition-fast">
              <Sparkles class="w-4 h-4" />
            </div>
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover/item:text-primary transition-fast">
                System Prompt Generator
              </div>
              <div class="text-[11px] text-text-tertiary mt-0.5 leading-snug">
                Synthesize production-grade LLM system prompts
              </div>
            </div>
          </a>
          
          <a
            href="/checker"
            class:list={[
              "flex items-start gap-3 p-2.5 rounded-lg transition-fast hover:bg-surface-secondary group/item",
              activeNav === 'checker' ? 'bg-primary-subtle/40' : ''
            ]}
            role="menuitem"
          >
            <div class="p-2 rounded-md bg-primary-subtle text-primary shrink-0 mt-0.5 group-hover/item:scale-105 transition-fast">
              <ShieldCheck class="w-4 h-4" />
            </div>
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover/item:text-primary transition-fast">
                Prompt Checker
              </div>
              <div class="text-[11px] text-text-tertiary mt-0.5 leading-snug">
                6-dimension quality scoring & diagnostic rule analysis
              </div>
            </div>
          </a>

          <a
            href="/prompt-length-optimizer"
            class:list={[
              "flex items-start gap-3 p-2.5 rounded-lg transition-fast hover:bg-surface-secondary group/item",
              activeNav === 'prompt-optimizer' ? 'bg-primary-subtle/40' : ''
            ]}
            role="menuitem"
          >
            <div class="p-2 rounded-md bg-primary-subtle text-primary shrink-0 mt-0.5 group-hover/item:scale-105 transition-fast">
              <Scissors class="w-4 h-4" />
            </div>
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover/item:text-primary transition-fast">
                Prompt Optimizer
              </div>
              <div class="text-[11px] text-text-tertiary mt-0.5 leading-snug">
                Heuristic length reduction & multi-model cost estimation
              </div>
            </div>
          </a>

          <a
            href="/prompt-injection-scanner"
            class:list={[
              "flex items-start gap-3 p-2.5 rounded-lg transition-fast hover:bg-surface-secondary group/item",
              activeNav === 'injection-scanner' ? 'bg-primary-subtle/40' : ''
            ]}
            role="menuitem"
          >
            <div class="p-2 rounded-md bg-primary-subtle text-primary shrink-0 mt-0.5 group-hover/item:scale-105 transition-fast">
              <ShieldAlert class="w-4 h-4" />
            </div>
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover/item:text-primary transition-fast">
                Injection Scanner
              </div>
              <div class="text-[11px] text-text-tertiary mt-0.5 leading-snug">
                Multi-vector prompt injection & red-teaming
              </div>
            </div>
          </a>

          <a
            href="/jailbreak-detector"
            class:list={[
              "flex items-start gap-3 p-2.5 rounded-lg transition-fast hover:bg-surface-secondary group/item",
              activeNav === 'jailbreak-detector' ? 'bg-primary-subtle/40' : ''
            ]}
            role="menuitem"
          >
            <div class="p-2 rounded-md bg-primary-subtle text-primary shrink-0 mt-0.5 group-hover/item:scale-105 transition-fast">
              <Shield class="w-4 h-4" />
            </div>
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover/item:text-primary transition-fast">
                AI Jailbreak Detector
              </div>
              <div class="text-[11px] text-text-tertiary mt-0.5 leading-snug">
                4-tier hybrid edge threat scanning & attestation
              </div>
            </div>
          </a>

          <a
            href="/ai-audit"
            class:list={[
              "flex items-start gap-3 p-2.5 rounded-lg transition-fast hover:bg-surface-secondary group/item",
              activeNav === 'ai-audit' ? 'bg-primary-subtle/40' : ''
            ]}
            role="menuitem"
          >
            <div class="p-2 rounded-md bg-primary-subtle text-primary shrink-0 mt-0.5 group-hover/item:scale-105 transition-fast">
              <Brain class="w-4 h-4" />
            </div>
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover/item:text-primary transition-fast">
                AI Auditor
              </div>
              <div class="text-[11px] text-text-tertiary mt-0.5 leading-snug">
                Audit LLM response accuracy & test automation execution
              </div>
            </div>
          </a>
        </div>
      </div>

      <a 
        href="/#features" 
        class:list={[
          "px-3 py-1.5 rounded-md text-sm font-medium transition-fast",
          activeNav === 'features' ? 'text-primary bg-primary-subtle/60 font-semibold' : 'text-text-secondary hover:text-text-primary hover:bg-surface-secondary'
        ]}
      >
        Features
      </a>

      <a 
        href="/pricing" 
        class:list={[
          "px-3 py-1.5 rounded-md text-sm font-medium transition-fast",
          activeNav === 'pricing' ? 'text-primary bg-primary-subtle/60 font-semibold' : 'text-text-secondary hover:text-text-primary hover:bg-surface-secondary'
        ]}
      >
        Pricing
      </a>

      <a 
        href="/docs" 
        class:list={[
          "px-3 py-1.5 rounded-md text-sm font-medium transition-fast",
          activeNav === 'docs' ? 'text-primary bg-primary-subtle/60 font-semibold' : 'text-text-secondary hover:text-text-primary hover:bg-surface-secondary'
        ]}
      >
        Documentation
      </a>

      <a 
        href="/articles" 
        class:list={[
          "px-3 py-1.5 rounded-md text-sm font-medium transition-fast",
          activeNav === 'articles' ? 'text-primary bg-primary-subtle/60 font-semibold' : 'text-text-secondary hover:text-text-primary hover:bg-surface-secondary'
        ]}
      >
        Articles
      </a>
    </nav>

    <!-- CTAs & Theme Toggle -->
    <div class="hidden md:flex items-center gap-2.5 shrink-0">
      <!-- Profile Avatar with Dropdown -->
      <div class="relative" id="profile-dropdown-container">
        <button
          id="header-user-avatar"
          class="flex items-center justify-center w-10 h-10 rounded-full border border-border bg-surface text-text-secondary hover:text-text-primary hover:border-text-tertiary transition-fast shrink-0 cursor-pointer"
          aria-label="User account"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <div class="w-full h-full rounded-full flex items-center justify-center font-bold font-mono text-[11px]" id="header-avatar-inner">
            <User class="w-4 h-4" />
          </div>
        </button>
        <div
          id="profile-dropdown-menu"
          class="absolute right-0 top-full mt-2 w-48 rounded-lg border border-border-subtle bg-canvas shadow-lg shadow-black/10 py-1.5 z-50 hidden"
          role="menu"
          aria-orientation="vertical"
        >
          <div id="dropdown-items-container">
            <!-- Populated dynamically via JS -->
          </div>
        </div>
      </div>

      <ThemeToggle />
      <Button href="/checker" size="sm" variant="secondary" class="h-9 min-h-[36px] px-3.5 text-xs font-medium">Try Checker</Button>
      <Button href="/signup" size="sm" variant="primary" class="h-9 min-h-[36px] px-3.5 text-xs font-medium">Sign Up Free</Button>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex items-center gap-2.5 md:hidden">
      <ThemeToggle />
      <button 
        id="mobile-nav-toggle"
        class="inline-flex items-center justify-center w-10 h-10 border border-border bg-surface text-text-secondary hover:text-text-primary rounded-md transition-fast focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary cursor-pointer"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span>
          <Menu class="w-4 h-4" />
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div 
    id="mobile-drawer"
    class="fixed inset-0 top-16 z-30 w-full h-[calc(100vh-64px)] bg-canvas border-t border-border-subtle translate-x-full transition-transform duration-slow ease-default md:hidden invisible overflow-y-auto"
  >
    <nav class="flex flex-col p-6 gap-6" aria-label="Mobile navigation">
      <div>
        <span class="text-[10px] font-mono font-semibold uppercase tracking-widest text-text-tertiary block mb-3">
          AI Quality Tools
        </span>
        <div class="grid grid-cols-1 gap-2">
          <a href="/prompt-rewriter" class="mobile-nav-link flex items-center gap-3 p-2.5 rounded-lg border border-border-subtle bg-surface text-sm font-medium text-text-primary hover:bg-surface-secondary" tabindex="-1">
            <Wand2 class="w-4 h-4 text-primary shrink-0" />
            <div>
              <div>Prompt Rewriter</div>
              <div class="text-[11px] text-text-tertiary font-normal">Model target prompt compiler</div>
            </div>
          </a>
          <a href="/ai-system-prompt-generator" class="mobile-nav-link flex items-center gap-3 p-2.5 rounded-lg border border-border-subtle bg-surface text-sm font-medium text-text-primary hover:bg-surface-secondary" tabindex="-1">
            <Sparkles class="w-4 h-4 text-primary shrink-0" />
            <div>
              <div>System Prompt Generator</div>
              <div class="text-[11px] text-text-tertiary font-normal">Synthesize LLM system prompts</div>
            </div>
          </a>
          <a href="/checker" class="mobile-nav-link flex items-center gap-3 p-2.5 rounded-lg border border-border-subtle bg-surface text-sm font-medium text-text-primary hover:bg-surface-secondary" tabindex="-1">
            <ShieldCheck class="w-4 h-4 text-primary shrink-0" />
            <div>
              <div>Prompt Checker</div>
              <div class="text-[11px] text-text-tertiary font-normal">6-dimension quality scoring</div>
            </div>
          </a>
          <a href="/prompt-length-optimizer" class="mobile-nav-link flex items-center gap-3 p-2.5 rounded-lg border border-border-subtle bg-surface text-sm font-medium text-text-primary hover:bg-surface-secondary" tabindex="-1">
            <Scissors class="w-4 h-4 text-primary shrink-0" />
            <div>
              <div>Prompt Optimizer</div>
              <div class="text-[11px] text-text-tertiary font-normal">Token & cost reduction</div>
            </div>
          </a>
          <a href="/prompt-injection-scanner" class="mobile-nav-link flex items-center gap-3 p-2.5 rounded-lg border border-border-subtle bg-surface text-sm font-medium text-text-primary hover:bg-surface-secondary" tabindex="-1">
            <ShieldAlert class="w-4 h-4 text-primary shrink-0" />
            <div>
              <div>Injection Scanner</div>
              <div class="text-[11px] text-text-tertiary font-normal">Security & guardrails</div>
            </div>
          </a>
          <a href="/ai-audit" class="mobile-nav-link flex items-center gap-3 p-2.5 rounded-lg border border-border-subtle bg-surface text-sm font-medium text-text-primary hover:bg-surface-secondary" tabindex="-1">
            <Brain class="w-4 h-4 text-primary shrink-0" />
            <div>
              <div>AI Auditor</div>
              <div class="text-[11px] text-text-tertiary font-normal">Test automation & audits</div>
            </div>
          </a>
        </div>
      </div>

      <div>
        <span class="text-[10px] font-mono font-semibold uppercase tracking-widest text-text-tertiary block mb-2">
          Navigation
        </span>
        <div class="flex flex-col gap-1">
          <a href="/#features" class="mobile-nav-link text-sm font-medium py-2 text-text-secondary hover:text-text-primary" tabindex="-1">Features</a>
          <a href="/pricing" class="mobile-nav-link text-sm font-medium py-2 text-text-secondary hover:text-text-primary" tabindex="-1">Pricing</a>
          <a href="/docs" class="mobile-nav-link text-sm font-medium py-2 text-text-secondary hover:text-text-primary" tabindex="-1">Documentation</a>
          <a href="/articles" class="mobile-nav-link text-sm font-medium py-2 text-text-secondary hover:text-text-primary" tabindex="-1">Articles</a>
        </div>
      </div>

      <div class="flex flex-col gap-3 pt-4 border-t border-border-subtle">
        <Button href="/checker" variant="secondary" class="w-full" tabindex="-1">Try Checker</Button>
        <Button href="/signup" variant="primary" class="w-full" tabindex="-1">Sign Up Free</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  // ===== Mobile drawer toggle (with focus trap + Escape) =====
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const links = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && drawer) {
    let isOpen = false;
    drawer.setAttribute('aria-hidden', 'true');

    const focusableElements = Array.from(drawer.querySelectorAll('a, button'));

    const openDrawer = () => {
      isOpen = true;
      toggleBtn.setAttribute('aria-expanded', 'true');
      drawer.setAttribute('aria-hidden', 'false');
      drawer.classList.remove('invisible');
      drawer.classList.remove('translate-x-full');
      drawer.classList.add('translate-x-0');
      document.body.style.overflow = 'hidden';
      focusableElements.forEach(el => el.removeAttribute('tabindex'));
      // Move focus into the drawer
      const first = focusableElements[0];
      if (first) (first as HTMLElement).focus();
    };

    const closeDrawer = (returnFocus: boolean) => {
      if (!isOpen) return;
      isOpen = false;
      toggleBtn.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('aria-hidden', 'true');
      drawer.classList.remove('translate-x-0');
      drawer.classList.add('translate-x-full');
      document.body.style.overflow = '';
      focusableElements.forEach(el => el.setAttribute('tabindex', '-1'));

      const handleTransitionEnd = () => {
        if (!isOpen) drawer.classList.add('invisible');
        drawer.removeEventListener('transitionend', handleTransitionEnd);
      };
      drawer.addEventListener('transitionend', handleTransitionEnd);

      if (returnFocus) toggleBtn.focus();
    };

    // Focus trap while drawer is open
    const handleDrawerTab = (e: KeyboardEvent) => {
      if (!isOpen) return;
      if (e.key !== 'Tab') return;
      const firstEl = focusableElements[0] as HTMLElement | undefined;
      const lastEl = focusableElements[focusableElements.length - 1] as HTMLElement | undefined;
      if (!firstEl || !lastEl) return;

      if (e.shiftKey && document.activeElement === firstEl) {
        e.preventDefault();
        lastEl.focus();
      } else if (!e.shiftKey && document.activeElement === lastEl) {
        e.preventDefault();
        firstEl.focus();
      }
    };

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        e.preventDefault();
        closeDrawer(true);
      }
    });

    toggleBtn.addEventListener('click', () => {
      if (isOpen) closeDrawer(true);
      else openDrawer();
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        if (isOpen) closeDrawer(true);
      });
    });

    document.addEventListener('keydown', handleDrawerTab);
  }

  // ===== Tools dropdown (hover + click + keyboard) =====
  const toolsContainer = document.getElementById('tools-dropdown-container');
  const toolsBtn = document.getElementById('tools-dropdown-btn');
  const toolsMenu = document.getElementById('tools-dropdown-menu');
  const toolsChevron = document.getElementById('tools-dropdown-chevron');

  if (toolsContainer && toolsBtn && toolsMenu) {
    let toolsOpen = false;
    const toolItems = Array.from(toolsMenu.querySelectorAll('[role="menuitem"]')) as HTMLElement[];

    const openTools = () => {
      toolsOpen = true;
      toolsBtn.setAttribute('aria-expanded', 'true');
      toolsMenu.classList.remove('invisible', 'opacity-0', 'translate-y-1');
      if (toolsChevron) toolsChevron.classList.add('rotate-180');
    };

    const closeTools = () => {
      toolsOpen = false;
      toolsBtn.setAttribute('aria-expanded', 'false');
      toolsMenu.classList.add('invisible', 'opacity-0', 'translate-y-1');
      if (toolsChevron) toolsChevron.classList.remove('rotate-180');
    };

    toolsBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (toolsOpen) closeTools();
      else {
        openTools();
        const first = toolItems[0];
        if (first) first.focus();
      }
    });

    toolsBtn.addEventListener('keydown', (e) => {
      if ((e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') && !toolsOpen) {
        e.preventDefault();
        openTools();
        const first = toolItems[0];
        if (first) first.focus();
      }
    });

    toolsMenu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeTools();
        toolsBtn.focus();
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const currentIdx = toolItems.indexOf(document.activeElement as HTMLElement);
        let nextIdx = e.key === 'ArrowDown'
          ? (currentIdx + 1) % toolItems.length
          : (currentIdx - 1 + toolItems.length) % toolItems.length;
        toolItems[nextIdx].focus();
      }
      if (e.key === 'Tab' && !e.shiftKey && toolItems.includes(document.activeElement as HTMLElement)) {
        closeTools();
      }
    });

    // Hover (mouse users)
    let hoverTimer: number | undefined;
    toolsContainer.addEventListener('mouseenter', () => {
      window.clearTimeout(hoverTimer);
      openTools();
    });
    toolsContainer.addEventListener('mouseleave', () => {
      hoverTimer = window.setTimeout(() => {
        if (document.activeElement !== toolsBtn && !toolsMenu.contains(document.activeElement)) {
          closeTools();
        }
      }, 120);
    });

    document.addEventListener('click', (e: MouseEvent) => {
      const target = e.target as Node;
      if (toolsOpen && !toolsContainer.contains(target)) closeTools();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toolsOpen) {
        closeTools();
        toolsBtn.focus();
      }
    });
  }

  // ===== Profile dropdown =====
  const avatarBtn = document.getElementById('header-user-avatar');
  const dropdown = document.getElementById('profile-dropdown-menu');
  const itemsContainer = document.getElementById('dropdown-items-container');
  const avatarInner = document.getElementById('header-avatar-inner');

  if (avatarBtn && dropdown && itemsContainer) {
    let dropdownOpen = false;

    const session = localStorage.getItem('user_session');
    let isLoggedIn = false;

    if (session && avatarInner) {
      try {
        const user = JSON.parse(session);
        if (user.email) {
          isLoggedIn = true;
          avatarInner.textContent = user.email.substring(0, 2).toUpperCase();
        }
      } catch (_) {}
    }

    const buildMenuItem = (href: string, label: string): HTMLAnchorElement => {
      const a = document.createElement('a');
      a.href = href;
      a.className = 'block px-4 py-2 text-sm text-text-secondary hover:text-text-primary hover:bg-surface-secondary transition-fast';
      a.setAttribute('role', 'menuitem');
      a.textContent = label;
      return a;
    };

    if (isLoggedIn) {
      itemsContainer.appendChild(buildMenuItem('/dashboard', 'Dashboard'));
      itemsContainer.appendChild(buildMenuItem('/library', 'Library'));
      itemsContainer.appendChild(buildMenuItem('/settings', 'Settings'));
      const sep = document.createElement('hr');
      sep.className = 'my-1 border-border-subtle';
      itemsContainer.appendChild(sep);
      const signOut = document.createElement('button');
      signOut.type = 'button';
      signOut.id = 'dropdown-signout';
      signOut.className = 'w-full text-left px-4 py-2 text-sm text-text-secondary hover:text-text-primary hover:bg-surface-secondary transition-fast cursor-pointer';
      signOut.setAttribute('role', 'menuitem');
      signOut.textContent = 'Sign Out';
      itemsContainer.appendChild(signOut);
    } else {
      itemsContainer.appendChild(buildMenuItem('/login', 'Sign In'));
      itemsContainer.appendChild(buildMenuItem('/signup', 'Sign Up'));
    }

    const openDropdown = () => {
      dropdownOpen = true;
      dropdown.classList.remove('hidden');
      avatarBtn.setAttribute('aria-expanded', 'true');
    };

    const closeDropdown = () => {
      dropdownOpen = false;
      dropdown.classList.add('hidden');
      avatarBtn.setAttribute('aria-expanded', 'false');
    };

    avatarBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (dropdownOpen) closeDropdown();
      else {
        openDropdown();
        const firstItem = dropdown.querySelector('[role="menuitem"]') as HTMLElement | null;
        if (firstItem) firstItem.focus();
      }
    });

    avatarBtn.addEventListener('keydown', (e) => {
      if ((e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') && !dropdownOpen) {
        e.preventDefault();
        openDropdown();
        const firstItem = dropdown.querySelector('[role="menuitem"]') as HTMLElement | null;
        if (firstItem) firstItem.focus();
      }
    });

    dropdown.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeDropdown();
        avatarBtn.focus();
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const items = Array.from(dropdown.querySelectorAll('[role="menuitem"]')) as HTMLElement[];
        const currentIdx = items.indexOf(document.activeElement as HTMLElement);
        if (currentIdx === -1) return;
        const nextIdx = e.key === 'ArrowDown'
          ? (currentIdx + 1) % items.length
          : (currentIdx - 1 + items.length) % items.length;
        items[nextIdx].focus();
      }
    });

    document.addEventListener('click', (e: MouseEvent) => {
      const target = e.target as Node;
      if (dropdownOpen && !avatarBtn.contains(target) && !dropdown.contains(target)) {
        closeDropdown();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dropdownOpen) closeDropdown();
    });

    const signOutBtn = document.getElementById('dropdown-signout');
    if (signOutBtn) {
      signOutBtn.addEventListener('click', async () => {
        // Revoke session server-side before clearing local state
        try {
          const session = JSON.parse(localStorage.getItem('user_session') || '{}');
          const token = session?.token || '';
          const csrfToken = session?.csrfToken || '';
          if (token && csrfToken) {
            await fetch('/api/auth/logout', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`,
                'X-CSRF-Token': csrfToken,
              },
            });
          }
        } catch (_) {
          // Best-effort — always clear local state below
        }
        localStorage.removeItem('user_session');
        window.location.href = '/';
      });
    }
  }
</script>