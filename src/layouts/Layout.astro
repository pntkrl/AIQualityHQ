---
import TechStackPopup from '../components/ui/TechStackPopup.astro';

const rawCanonical = Astro.url.href;
const normalizedDomain = rawCanonical
  .replace('https://www.aiqualityhq.com', 'https://aiqualityhq.com')
  .replace('http://www.aiqualityhq.com', 'https://aiqualityhq.com')
  .replace('http://aiqualityhq.com', 'https://aiqualityhq.com');
const formattedCanonical = (normalizedDomain.endsWith('/') && normalizedDomain !== 'https://aiqualityhq.com/') 
  ? normalizedDomain.slice(0, -1).replace(/\.html$/, '')
  : normalizedDomain.replace(/\.html$/, '');
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="linkwatcher-verification" content="linkwatcher-verify-dy5bdtt7o8q" />
		<meta name="websitelaunches-verification" content="efad92eecfa84f87bb4fbe1d96a98085" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="AIQualityHQ" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={formattedCanonical} />
		<!-- Deferred Third-Party Scripts — loaded on first user interaction for performance -->
		<script>
			(function() {
				let loaded = false;
				function loadDeferredScripts() {
					if (loaded) return;
					loaded = true;
					
					// Ahrefs Analytics
					const ahrefs = document.createElement('script');
					ahrefs.src = 'https://analytics.ahrefs.com/analytics.js';
					ahrefs.setAttribute('data-key', 'jl3atvtnDRzKcw7dT/UZrg');
					ahrefs.async = true;
					document.head.appendChild(ahrefs);

					// CodeMarket Widget
					const codemarket = document.createElement('script');
					codemarket.src = 'https://code.market/widget.min.js';
					codemarket.async = true;
					document.head.appendChild(codemarket);

					triggerEvents.forEach(e => window.removeEventListener(e, loadDeferredScripts, { passive: true }));
				}
				const triggerEvents = ['scroll', 'mousemove', 'touchstart', 'keydown'];
				triggerEvents.forEach(e => window.addEventListener(e, loadDeferredScripts, { passive: true }));
				setTimeout(loadDeferredScripts, 4000);
			})();
		</script>
		<title>AIQualityHQ</title>
	</head>
	<body>
		<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary focus:text-on-primary focus:rounded-lg focus:text-sm focus:font-semibold">
			Skip to main content
		</a>
		<slot />
		<TechStackPopup />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		max-width: 100vw;
		overflow-x: hidden;
		position: relative;
	}
</style>
